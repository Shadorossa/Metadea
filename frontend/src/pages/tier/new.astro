---
import '../../styles/pages/tier.css';
// MediaSearchPopup's own styles (the add-items search).
import '../../styles/pages/media/editor.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLang, useTranslations } from '../../i18n/index';
import TierMaker from '../../components/tier/TierMaker';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`${t.tier.title} — Metadea`} titleKey="tier.title" lang={lang} activePage="tier">
  <main class="tier-new-page">
    <TierMaker client:load />
  </main>
</BaseLayout>
