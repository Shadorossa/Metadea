---
import "../styles/pages/settings.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLang, useTranslations } from "../i18n/index";
import pkg from "../../package.json";
import {
  ICON_SETTINGS_APPEARANCE,
  ICON_SETTINGS_CONNECTIONS,
  ICON_SETTINGS_ENVIRONMENT,
  ICON_SETTINGS_ADMIN,
  ICON_SETTINGS_PREFERENCES,
  ICON_SETTINGS_ACCESSIBILITY,
} from "../lib/dom/icon-strings";
import ProfileTab from "../components/settings/ProfileTab.astro";
import PreferencesTab from "../components/settings/PreferencesTab.astro";
import EnvironmentTab from "../components/settings/EnvironmentTab.astro";
import ConnectionsTab from "../components/settings/ConnectionsTab.astro";
import EmulatorsTab from "../components/settings/EmulatorsTab.astro";
import AccessibilityTab from "../components/settings/AccessibilityTab.astro";
import HelpModals from "../components/settings/HelpModals.astro";
import BackupRestoreTab from "../components/settings/BackupRestoreTab.astro";
import PluginsTab from "../components/settings/PluginsTab.astro";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const version = pkg.version;
---

<BaseLayout title={`${t.settings.title} — Metadea`} titleKey="settings.title" lang={lang} activePage="settings">
  <div class="settings-page">
    <div class="settings-container">
      <!-- Sidebar vertical -->
      <aside class="settings-sidebar">
        <span class="section-label settings-sidebar-label" data-i18n="settings.section_account"
          >{t.settings.section_account}</span
        >
        <button class="settings-tab active" data-tab="profile">
          <Fragment set:html={ICON_SETTINGS_APPEARANCE} />
          <span data-i18n="settings.section_appearance">{t.settings.section_appearance}</span>
        </button>
        <button class="settings-tab" data-tab="preferences">
          <Fragment set:html={ICON_SETTINGS_PREFERENCES} />
          <span data-i18n="settings.tab_preferences">{t.settings.tab_preferences}</span>
        </button>
        <button class="settings-tab" data-tab="application">
          <Fragment set:html={ICON_SETTINGS_CONNECTIONS} />
          <span data-i18n="settings.tab_application">{t.settings.tab_application}</span>
        </button>

        <span
          class="section-label settings-sidebar-label"
          style="margin-top: 1rem; display: block;"
          data-i18n="settings.section_application"
          >{t.settings.section_application}</span
        >
        <button class="settings-tab" data-tab="environment">
          <Fragment set:html={ICON_SETTINGS_ENVIRONMENT} />
          <span data-i18n="settings.tab_environment">{t.settings.tab_environment}</span>
        </button>
        <button class="settings-tab" data-tab="emulators">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="17 16.1 13.6 18.9 13.6 22.6 22.1 22.6 22.1 18.9"/>
            <polyline points="6.4 2.4 2.9 5.2 2.9 12.8 13.6 12.8 13.6 5.2"/>
            <line x1="2.9" y1="19" x2="13.6" y2="19"/>
            <line x1="6.4" y1="18.9" x2="6.4" y2="22.6"/>
            <line x1="10.1" y1="18.9" x2="10.1" y2="22.6"/>
          </svg>
          <span data-i18n="settings.tab_emulators">{t.settings.tab_emulators}</span>
        </button>
        <button class="settings-tab" data-tab="accessibility">
          <Fragment set:html={ICON_SETTINGS_ACCESSIBILITY} />
          <span data-i18n="settings.tab_accessibility">{t.settings.tab_accessibility}</span>
        </button>
        <a href="/guide" class="settings-tab" id="settings-guide-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
          </svg>
          <span data-i18n="guide.nav_link">{t.guide.nav_link}</span>
        </a>

        <span
          class="section-label settings-sidebar-label"
          id="settings-admin-label"
          style="margin-top: 1rem;"
          data-i18n="settings.section_admin"
          >{t.settings.section_admin}</span
        >
        <a href="/admin/catalog" class="settings-tab" id="settings-admin-link">
          <Fragment set:html={ICON_SETTINGS_ADMIN} />
          <span data-i18n="settings.tab_admin">{t.settings.tab_admin}</span>
        </a>
        <button class="settings-tab" data-tab="backup">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16v16H4z"/><path d="M8 4v4h8V4M8 14h8M8 17h5"/>
          </svg>
          <span data-i18n="settings.tab_backup">{t.settings.tab_backup}</span>
        </button>
        <button class="settings-tab" data-tab="plugins">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15.39 4.39a1 1 0 0 0 1.68-.47 2.5 2.5 0 1 1 3.01 3.01 1 1 0 0 0-.47 1.68l1.57 1.57c.47.47.7 1.08.7 1.7s-.23 1.23-.7 1.7l-1.6 1.6a1 1 0 0 1-1.61-.37 2.5 2.5 0 1 0-3.21 3.21 1 1 0 0 1 .37 1.61l-1.6 1.6a2.4 2.4 0 0 1-3.4 0l-1.57-1.57a1 1 0 0 0-1.68.47 2.5 2.5 0 1 1-3.01-3.01 1 1 0 0 0 .47-1.68L2.7 13.7a2.4 2.4 0 0 1 0-3.4l1.6-1.6a1 1 0 0 1 1.61.37 2.5 2.5 0 1 0 3.21-3.21 1 1 0 0 1-.37-1.61l1.6-1.6a2.4 2.4 0 0 1 3.4 0z"/>
          </svg>
          <span data-i18n="plugins.tab">{t.plugins.tab}</span>
        </button>
      </aside>

      <!-- Contenido -->
      <div class="settings-content">
        <ProfileTab t={t} />
        <PreferencesTab t={t} />
        <EnvironmentTab t={t} version={version} />
        <EmulatorsTab t={t} />
        <AccessibilityTab t={t} />
        <ConnectionsTab t={t} />
        <BackupRestoreTab t={t} />
        <PluginsTab t={t} />
      </div>
    </div>
  </div>

  <HelpModals t={t} />

  <!-- Toast -->
  <div class="settings-toast" id="settings-toast" data-i18n="settings.env_saved">{t.settings.env_saved}</div>
</BaseLayout>

<script>
  import { getAuthToken, clearAuthToken } from "../lib/tauri";
  import { decodeJwtPayload } from "../lib/profile/media-type-label";
  import { initAvatar, initShareAvatar } from "../components/settings/mount/avatar";
  import { initBanner } from "../components/settings/mount/banner";
  import { initThemePicker } from "../components/settings/mount/theme";
  import { initBigPictureSkinPicker } from "../components/settings/mount/big-picture-skin";
  import { initEnvironment } from "../components/settings/mount/environment";
  import { initPlayerPreferences } from "../components/settings/mount/player-preferences";
  import { initBigPicturePreferences } from "../components/settings/mount/big-picture-preferences";
  import { initAmbientModePreferences } from "../components/settings/mount/ambient-mode-preferences";
  import { initSpoilerPreferences } from "../components/settings/mount/spoiler-preferences";
  import { initEmulators } from "../components/settings/mount/emulators";
  import { initSavesSettings } from "../components/settings/mount/saves-settings";
  import { initBreakReminderSettings } from "../components/settings/mount/break-reminder-settings";
  import { initFontPicker } from "../components/settings/mount/fonts";
  import { initGitHubAuth } from "../components/settings/mount/github";
  import { initAniListAuth } from "../components/settings/mount/anilist";
  import { initAniListImportUI } from "../components/settings/mount/anilist-import-ui";
  import { initMal } from "../components/settings/mount/mal";
  import { initDisplayName } from "../components/settings/mount/display-name";
  import { initRatingSystem } from "../components/settings/mount/rating-system";
  import { initCustomColor } from "../components/settings/mount/custom-color";
  import { initActivitySettings } from "../components/settings/mount/activity";
  import { initDualRating } from "../components/settings/mount/dual-rating";
  import { initLanguageSwitcher } from "../components/settings/mount/language";
  import { initUiScaleSetting } from "../components/settings/mount/ui-scale";
  import { initBio } from "../components/settings/mount/bio";
  import { initWebProfile } from "../components/settings/mount/web-profile";
  import { initUpdater } from "../components/settings/mount/updater";
  import { initCommunityCatalogSync } from "../components/settings/mount/community-catalog";
  import { initFixCharacterIds } from "../components/settings/mount/fix-character-ids";
  import { initSettingsTabs } from "../components/settings/mount/tabs";
  import { getT } from "../i18n/runtime";
  import { initBackupRestore } from "../components/settings/mount/backup-restore";

  function showToast(msg?: string) {
    const clientT = getT();
    const el = document.getElementById("settings-toast")!;
    el.textContent = msg || clientT.settings.env_saved;
    el.classList.add("visible");
    setTimeout(() => el.classList.remove("visible"), 2000);
  }

  function setupHelpModals() {
    const allBtns = document.querySelectorAll("button[data-help]");

    allBtns.forEach((btn) => {
      btn.addEventListener("click", function(e) {
        e.preventDefault();
        e.stopPropagation();
        const helpType = this.getAttribute("data-help");
        const modalId = helpType + "-help-modal";
        const modal = document.getElementById(modalId) as HTMLElement | null;
        if (modal) {
          modal.classList.remove("hidden");
        }
      });
    });

    document.querySelectorAll(".settings-help-modal-close").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const modal = (e.target as HTMLElement).closest(".settings-help-modal") as HTMLElement | null;
        if (modal) modal.classList.add("hidden");
      });
    });

    document.querySelectorAll(".settings-help-modal-overlay").forEach(overlay => {
      overlay.addEventListener("click", (e) => {
        const modal = (e.target as HTMLElement).closest(".settings-help-modal") as HTMLElement | null;
        if (modal) modal.classList.add("hidden");
      });
    });
  }

  // Setup help modals on initial page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHelpModals);
  } else {
    setupHelpModals();
  }

  document.addEventListener("astro:page-load", async () => {
    // This listener is registered once and never removed, but astro:page-load
    // fires on every SPA navigation, not just to this page — once /settings
    // has been visited once, every future navigation anywhere else re-ran
    // this handler, including the unconditional redirect-to-/login below if
    // the session check ever failed. Bail out if we're not actually on
    // /settings (see the same fix on profile.astro/character.astro).
    if (!document.querySelector('.settings-page')) return;

    const session = await getAuthToken().catch(() => null);
    if (!session?.token) {
      window.location.replace("/login");
      return;
    }

    const payload = decodeJwtPayload(session.token);
    const googleAvatar = payload.avatar as string | null;
    const username = session.username;

    initAvatar(googleAvatar, username, showToast);
    initShareAvatar(showToast);
    initBanner(showToast);
    initFontPicker(username, showToast);
    initThemePicker(showToast);
    initBigPictureSkinPicker(showToast);
    initEnvironment(showToast);
    initPlayerPreferences();
    initBigPicturePreferences();
    initAmbientModePreferences();
    initSpoilerPreferences(showToast);
    initEmulators(showToast);
    initSavesSettings(showToast);
    initBreakReminderSettings(showToast);
    initGitHubAuth();
    initAniListAuth();
    initAniListImportUI(showToast);
    initMal(showToast);
    initDisplayName(showToast);
    initRatingSystem(showToast);
    initCustomColor(showToast);
    initActivitySettings(showToast);
    initDualRating(showToast);
    initLanguageSwitcher();
    initUiScaleSetting();
    initBio(showToast);
    initWebProfile(showToast);

    // Lógica para alternar las plataformas de API (Paginado)
    const platformBtns = document.querySelectorAll(".api-platform-tab-btn");
    const placeholder = document.getElementById("api-keys-placeholder");
    const forms = document.querySelectorAll(".api-platform-form-block");

    platformBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const plat = (btn as HTMLElement).dataset.platform;
        
        // Toggle active button
        const wasActive = btn.classList.contains("active");
        platformBtns.forEach(b => b.classList.remove("active"));
        forms.forEach(f => f.classList.add("hidden"));
        
        if (wasActive) {
          // If clicked the active tab, return to placeholder state
          placeholder?.classList.remove("hidden");
        } else {
          btn.classList.add("active");
          placeholder?.classList.add("hidden");
          const targetForm = document.getElementById(`api-form-${plat}`);
          if (targetForm) targetForm.classList.remove("hidden");
        }
      });
    });

    document.getElementById("settings-signout-btn")?.addEventListener("click", async () => {
      await clearAuthToken().catch(() => {});
      window.location.href = "/";
    });

    const defaultVersion =
      (document.querySelector(".app-curr-ver") as HTMLElement | null)?.dataset.version || "0.1.9";
    initUpdater(defaultVersion);
    initCommunityCatalogSync();
    initFixCharacterIds();
    initSettingsTabs();
    initBackupRestore();

    // Re-setup help modals on SPA navigation
    setupHelpModals();
  });
</script>
