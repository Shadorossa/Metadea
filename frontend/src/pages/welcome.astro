---
import '../styles/pages/welcome.css';
import '../styles/pages/settings.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, useTranslations } from '../i18n/index';
import ProfileTab from '../components/settings/ProfileTab.astro';
import PreferencesTab from '../components/settings/PreferencesTab.astro';
import EnvironmentTab from '../components/settings/EnvironmentTab.astro';
import EmulatorsTab from '../components/settings/EmulatorsTab.astro';
import ConnectionsTab from '../components/settings/ConnectionsTab.astro';
import HelpModals from '../components/settings/HelpModals.astro';
import { UiThemesSection } from '../components/ui-themes/UiThemesSection';
import OnboardingStep from '../components/welcome/OnboardingStep.astro';
import OnboardingStepIcon from '../components/welcome/OnboardingStepIcon.astro';
import OnboardingNavGuide from '../components/welcome/OnboardingNavGuide.astro';
import { ONBOARDING_STEPS } from '../lib/welcome/onboarding-steps';
import { SERVICE_BRAND_NAMES, SERVICE_PLATFORM_IDS } from '../lib/welcome/settings-tabs';
import { BookOpen, Gamepad2, Library, MonitorPlay, RefreshCw } from 'lucide-react';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const w = t.onboarding;
const step = (id: string) => ONBOARDING_STEPS.findIndex((item) => item.id === id);
const def = (id: string) => ONBOARDING_STEPS[step(id)];
const highlights = [
  { id: 'track', Icon: Library },
  { id: 'play', Icon: Gamepad2 },
  { id: 'watch', Icon: MonitorPlay },
  { id: 'sync', Icon: RefreshCw },
] as const;
const emulatorChecklist = ['emulator', 'roms', 'screenshots', 'rename'] as const;
const connectionNotes = ['anilist', 'mal', 'github', 'vndb'] as const;
const finishTips = ['search', 'shortcuts', 'discord', 'jukebox'] as const;
---

<BaseLayout title={`${w.title} - Metadea`} titleKey="onboarding.title" titleSuffix=" - Metadea" lang={lang} activePage="home">
  <main class="onboarding-page">
    <section class="onboarding-card" aria-labelledby="onboarding-title">
      <header class="onboarding-header">
        <span class="onboarding-brand">METADEA</span>
        <h1 id="onboarding-title" data-i18n="onboarding.title">{w.title}</h1>
        <p data-i18n="onboarding.subtitle">{w.subtitle}</p>
        <nav class="onboarding-stepper" aria-label={w.stepper_label} data-i18n-aria-label="onboarding.stepper_label">
          <ol>
            {ONBOARDING_STEPS.map((item, index) => (
              <li>
                <button
                  type="button"
                  class="onboarding-stepper-btn"
                  data-step-target={index}
                  aria-label={w.steps[item.id].label}
                  title={w.steps[item.id].label}
                  data-i18n-title={`onboarding.steps.${item.id}.label`}
                  data-i18n-aria-label={`onboarding.steps.${item.id}.label`}
                >
                  <OnboardingStepIcon icon={item.icon} size={16} />
                </button>
              </li>
            ))}
          </ol>
        </nav>
        <div class="onboarding-progress-row">
          <span id="onboarding-step-count" class="onboarding-step-count" aria-live="polite"></span>
          <span id="onboarding-step-label" class="onboarding-step-label"></span>
        </div>
        <div class="onboarding-progress" role="progressbar" aria-label={w.title} data-i18n-aria-label="onboarding.title" aria-valuemin="1" aria-valuemax={ONBOARDING_STEPS.length} aria-valuenow="1">
          <span id="onboarding-progress-fill"></span>
        </div>
      </header>

      <OnboardingStep t={t} step={def('intro')} index={step('intro')}>
        <ul class="onboarding-highlights">
          {highlights.map(({ id, Icon }) => (
            <li class="onboarding-highlight">
              <span class="onboarding-highlight-icon" aria-hidden="true"><Icon size={20} strokeWidth={1.8} /></span>
              <strong data-i18n={`onboarding.highlights.${id}_title`}>{w.highlights[`${id}_title`]}</strong>
              <small data-i18n={`onboarding.highlights.${id}_body`}>{w.highlights[`${id}_body`]}</small>
            </li>
          ))}
        </ul>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('basics')} index={step('basics')}>
        <div class="onboarding-basic-grid">
          <div id="onboarding-basic-language" class="onboarding-config-slot"></div>
          <div id="onboarding-basic-theme" class="onboarding-config-slot"></div>
        </div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('ui_theme')} index={step('ui_theme')}>
        <div class="onboarding-config-slot onboarding-ui-themes">
          <UiThemesSection client:only="react" />
        </div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('profile')} index={step('profile')}>
        <div id="onboarding-profile-content" class="onboarding-profile-slot"></div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('library')} index={step('library')}>
        <div id="onboarding-library-content" class="onboarding-library-slot">
          <div id="onboarding-library-rating-row" class="onboarding-library-rating-row"></div>
        </div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('player')} index={step('player')}>
        <div id="onboarding-player-content" class="onboarding-config-slot"></div>
        <p class="onboarding-note" data-i18n="onboarding.player_libmpv_note">{w.player_libmpv_note}</p>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('local')} index={step('local')}>
        <div id="onboarding-local-content" class="onboarding-config-slot"></div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('services')} index={step('services')}>
        <ul class="onboarding-service-list" aria-label={w.services_list_label} data-i18n-aria-label="onboarding.services_list_label">
          {SERVICE_PLATFORM_IDS.map((platform) => (
            <li>
              <button type="button" class="onboarding-service-btn" data-open-platform={platform}>
                <strong>{SERVICE_BRAND_NAMES[platform]}</strong>
                <small data-i18n={`onboarding.services.${platform}_why`}>{w.services[`${platform}_why`]}</small>
              </button>
            </li>
          ))}
        </ul>
        <div id="onboarding-api-content" class="onboarding-config-slot"></div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('emulators')} index={step('emulators')}>
        <ol class="onboarding-checklist">
          {emulatorChecklist.map((id) => (
            <li data-i18n={`onboarding.emulator_checklist.${id}`}>{w.emulator_checklist[id]}</li>
          ))}
        </ol>
        <div id="onboarding-emulators-content" class="onboarding-config-slot"></div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('connections')} index={step('connections')}>
        <ul class="onboarding-checklist onboarding-checklist--plain">
          {connectionNotes.map((id) => (
            <li data-i18n={`onboarding.connection_notes.${id}`}>{w.connection_notes[id]}</li>
          ))}
        </ul>
        <div id="onboarding-connections-content" class="onboarding-config-slot"></div>
      </OnboardingStep>

      <OnboardingStep t={t} step={def('finish')} index={step('finish')}>
        <div class="onboarding-guide-cta">
          <span class="onboarding-guide-cta-icon" aria-hidden="true"><BookOpen size={26} strokeWidth={1.7} /></span>
          <div>
            <strong data-i18n="onboarding.guide_cta_title">{w.guide_cta_title}</strong>
            <small data-i18n="onboarding.guide_cta_body">{w.guide_cta_body}</small>
          </div>
          <button id="onboarding-open-guide" class="btn btn--secondary" type="button" data-i18n="onboarding.guide_cta_button">{w.guide_cta_button}</button>
        </div>
        <ul class="onboarding-tips">
          {finishTips.map((id) => (
            <li data-i18n={`onboarding.finish_tips.${id}`}>{w.finish_tips[id]}</li>
          ))}
        </ul>
        <OnboardingNavGuide t={t} />
      </OnboardingStep>

      <footer class="onboarding-footer">
        <button id="onboarding-skip" class="btn btn--ghost" type="button" data-i18n="onboarding.skip">{w.skip}</button>
        <div class="onboarding-nav-buttons">
          <button id="onboarding-back" class="btn btn--secondary" type="button" hidden data-i18n="onboarding.back">{w.back}</button>
          <button id="onboarding-next" class="btn btn--primary" type="button" data-i18n="onboarding.next">{w.next}</button>
          <button id="onboarding-finish" class="btn btn--primary" type="button" hidden data-i18n="onboarding.finish">{w.finish}</button>
        </div>
      </footer>
    </section>
  </main>
  <div id="welcome-config-source" hidden aria-hidden="true">
    <ProfileTab t={t} onboarding={true} />
    <PreferencesTab t={t} />
    <EnvironmentTab t={t} onboarding={true} />
    <EmulatorsTab t={t} />
    <ConnectionsTab t={t} />
  </div>
  <HelpModals t={t} />
  <div class="settings-toast" id="settings-toast" data-i18n="settings.env_saved">{t.settings.env_saved}</div>
</BaseLayout>

<script>
  import { mountOnboarding, syncOnboardingChrome } from '../components/welcome/mount/onboarding';

  document.addEventListener('astro:page-load', () => {
    const isOnboarding = syncOnboardingChrome();
    if (isOnboarding) {
      mountOnboarding().catch((error) => console.error('[Welcome] Failed to initialize:', error));
    }
  });
</script>
