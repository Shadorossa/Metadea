---
import '../styles/pages/character.css';
import '../styles/pages/media.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, useTranslations } from '../i18n/index';
import CharacterPage from '../components/character/page/CharacterPage';

const lang = getLang(Astro.url);
const translations = useTranslations(lang);
---

<BaseLayout title={`${translations.character.page_title} — Metadea`} titleKey="character.page_title" lang={lang} activePage="search">
  <div class="media-page">
    <CharacterPage client:load i18n={{ character: translations.character }} />
  </div>
</BaseLayout>
