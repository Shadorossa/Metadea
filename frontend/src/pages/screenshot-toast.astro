---
// The always-on-top native toast window (src-tauri/src/folders/toast_window.rs):
// one page, two notices — the F12 "screenshot saved" card (click-through)
// and the "marked as watched" card with its Undo button. Which one shows is
// decided by the event the window receives.
import '../styles/pages/screenshot-toast.css';
import { getT } from '../i18n/runtime';
import LocaleBootstrap from '../components/i18n/LocaleBootstrap.astro';

const t = getT();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <LocaleBootstrap buildLang="en" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Metadea</title>
  </head>
  <body>
    <main class="screenshot-toast-page">
      <section class="screenshot-toast-card" id="screenshot-toast" role="status" aria-live="polite">
        <span class="screenshot-toast-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" id="screenshot-toast-icon-camera">
            <path d="M4 7.5h3l1.4-2h7.2l1.4 2h3A1.5 1.5 0 0 1 21.5 9v9a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 18V9A1.5 1.5 0 0 1 4 7.5Z" />
            <circle cx="12" cy="13" r="3.5" />
            <path d="M18 10h.01" />
          </svg>
          <svg viewBox="0 0 24 24" fill="none" id="screenshot-toast-icon-check" hidden>
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        <span class="screenshot-toast-content">
          <strong class="screenshot-toast-title" id="screenshot-toast-title" data-i18n="local.screenshot_saved">{t.local.screenshot_saved}</strong>
          <span class="screenshot-toast-work" id="screenshot-toast-work"></span>
          <span class="screenshot-toast-meta" id="screenshot-toast-meta">
            <span class="screenshot-toast-episode" id="screenshot-toast-episode"></span>
            <span aria-hidden="true">·</span>
            <span class="screenshot-toast-time" id="screenshot-toast-time"></span>
          </span>
        </span>
        <button type="button" class="screenshot-toast-undo" id="screenshot-toast-undo" hidden data-i18n="player.watched_toast_undo">{t.player.watched_toast_undo}</button>
      </section>
    </main>
  </body>
</html>

<script>
  import { listen } from '@tauri-apps/api/event';
  import { invoke } from '@tauri-apps/api/core';
  import { getT } from '../i18n/runtime';

  type ScreenshotToastPayload = {
    work_name: string;
    episode_label: string;
    timecode: string;
  };

  type EpisodeWatchedToastPayload = {
    work_name: string;
    episode_label: string;
    token: number;
  };

  // Rust hides the window itself (3.2 s / 8 s); the card fades a little
  // earlier so it is never cut mid-frame.
  const SCREENSHOT_VISIBLE_MS = 2600;
  const WATCHED_VISIBLE_MS = 7600;

  const t = getT();
  const toast = document.getElementById('screenshot-toast');
  const title = document.getElementById('screenshot-toast-title');
  const work = document.getElementById('screenshot-toast-work');
  const meta = document.getElementById('screenshot-toast-meta');
  const episode = document.getElementById('screenshot-toast-episode');
  const time = document.getElementById('screenshot-toast-time');
  const undo = document.getElementById('screenshot-toast-undo') as HTMLButtonElement | null;
  const cameraIcon = document.getElementById('screenshot-toast-icon-camera');
  const checkIcon = document.getElementById('screenshot-toast-icon-check');
  let hideTimer: number | undefined;
  let undoToken: number | null = null;

  function reveal(visibleMs: number) {
    if (!toast) return;
    toast.classList.remove('is-visible');
    void toast.getBoundingClientRect();
    toast.classList.add('is-visible');
    if (hideTimer !== undefined) window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => toast.classList.remove('is-visible'), visibleMs);
  }

  function setKind(kind: 'screenshot' | 'watched') {
    const watched = kind === 'watched';
    toast?.classList.toggle('screenshot-toast-card--watched', watched);
    if (cameraIcon) cameraIcon.hidden = watched;
    if (checkIcon) checkIcon.hidden = !watched;
    if (meta) meta.hidden = watched;
    if (undo) undo.hidden = !watched;
  }

  function showScreenshotToast(payload: ScreenshotToastPayload) {
    if (!title || !work || !episode || !time) return;
    setKind('screenshot');
    undoToken = null;
    title.textContent = t.local.screenshot_saved;
    work.textContent = payload.work_name;
    episode.textContent = payload.episode_label;
    const timecode = payload.timecode.match(/^(\d+)h(\d{2})m(\d{2})s(\d{3})$/);
    time.textContent = timecode
      ? `${timecode[1]}:${timecode[2]}:${timecode[3]}.${timecode[4]}`
      : payload.timecode;
    reveal(SCREENSHOT_VISIBLE_MS);
  }

  // "<Series> · E02" under the translated "Marked as watched" title, with
  // Undo on the right; the token goes back so the app reverts that mark.
  function showWatchedToast(payload: EpisodeWatchedToastPayload) {
    if (!title || !work) return;
    setKind('watched');
    undoToken = payload.token;
    title.textContent = t.player.watched_toast_title;
    work.textContent = `${payload.work_name} · ${payload.episode_label}`;
    reveal(WATCHED_VISIBLE_MS);
  }

  undo?.addEventListener('click', () => {
    if (undoToken === null) return;
    const token = undoToken;
    undoToken = null;
    undo.disabled = true;
    invoke('episode_toast_action', { action: 'undo', token })
      .catch(error => console.error('[Toast] Undo failed:', error))
      .finally(() => { undo.disabled = false; toast?.classList.remove('is-visible'); });
  });

  Promise.all([
    listen<ScreenshotToastPayload>('local-screenshot-saved', event => showScreenshotToast(event.payload)),
    listen<EpisodeWatchedToastPayload>('local-episode-watched', event => showWatchedToast(event.payload)),
  ])
    .then(() => invoke('screenshot_toast_ready'))
    .catch(error => console.error('[Screenshot toast] Failed to initialize:', error));
</script>
