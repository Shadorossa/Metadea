---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/profile.css';
import '../styles/pages/media.css';
import { getLang, useTranslations } from '../i18n/index';
import { ProfileLibraryEditor } from '../components/profile/ProfileLibraryEditor';
import {
  ICON_PROFILE_OVERVIEW,
  ICON_PROFILE_LIBRARY,
  ICON_PROFILE_FAVORITES,
  ICON_PROFILE_STATS,
  ICON_PROFILE_REVIEWS,
  ICON_PROFILE_LISTS,
} from '../lib/shared/icon-strings';

const lang = getLang(Astro.url);
const t    = useTranslations(lang);
---

<BaseLayout title="Perfil — Metadea" lang={lang} activePage="profile">
  <main class="profile-page">

    <div class="profile-banner">
      <div class="profile-banner-content" id="banner-content">
        <script is:inline>
          (function() {
            var fontFiles = {
              inter: 'inter/Inter-VariableFont_opsz,wght.woff2',
              roboto: 'roboto/Roboto-VariableFont_wdth,wght.woff2',
              montserrat: 'montserrat/Montserrat-VariableFont_wght.woff2',
              raleway: 'raleway/Raleway-VariableFont_wght.woff2',
              syne: 'syne/Syne-VariableFont_wght.woff2',
              sourcesanspro: 'sourcesanspro/SourceSans3-VariableFont_wght.woff2',
              lora: 'lora/Lora-VariableFont_wght.woff2',
              playfairdisplay: 'playfairdisplay/PlayfairDisplay-VariableFont_wght.woff2',
              alegreya: 'alegreya/Alegreya-VariableFont_wght.woff2',
              fraunces: 'fraunces/Fraunces-VariableFont_SOFT,WONK,opsz,wght.woff2',
              librebaskerville: 'librebaskerville/LibreBaskerville-Bold.woff2',
              inconsolata: 'inconsolata/Inconsolata-VariableFont_wdth,wght.woff2'
            };
            var bannerCache = localStorage.getItem('profile_banner_cache');
            var avatarCache = localStorage.getItem('profile_avatar_cache');
            var fontCache = localStorage.getItem('profile_font_cache') || 'inter';
            var nameCache = localStorage.getItem('auth_username') || localStorage.getItem('profile_username_cache') || '';
            
            var fontFile = fontFiles[fontCache];
            if (fontFile) {
              var s = document.createElement('style');
              // A unique family name per font (not a shared "profile-font"
              // constant) so switching fonts in Settings is guaranteed to
              // actually change the h1's rendered font-family value and
              // force a repaint — reusing the same family name across
              // navigations relied on the browser silently rebinding an
              // already-painted @font-face, which isn't reliable.
              s.textContent = '@font-face { font-family: "pf-' + fontCache + '"; src: url("/fonts/' + fontFile + '") format("woff2"); font-display: block; }';
              document.head.appendChild(s);
            }

            if (bannerCache) {
              var sBanner = document.createElement('style');
              sBanner.id = 'early-banner-style';
              sBanner.textContent = '.profile-banner { background-image: url("' + bannerCache.replace(/"/g, '\\"') + '") !important; background-size: cover !important; background-position: center !important; } .profile-banner::after { display: none !important; }';
              document.head.appendChild(sBanner);
            }
            if (nameCache) {
              var avatarHtml = avatarCache
                ? '<img class="profile-avatar" src="' + avatarCache + '" alt="' + nameCache + '" referrerpolicy="no-referrer">'
                : '<div class="profile-avatar-placeholder">' + (nameCache[0] || '?').toUpperCase() + '</div>';
              var container = document.getElementById('banner-content');
              if (container) {
                container.innerHTML = avatarHtml + '<h1 class="profile-username-large" style="font-family: \'pf-' + fontCache + '\', sans-serif;">' + nameCache + '</h1>';
              }
            }
          })();
        </script>
      </div>
    </div>

    <div class="profile-tabs-divider">
      <div class="profile-divider-line"></div>
    </div>

    <nav class="profile-tabs">
      <button class="profile-tab active" data-tab="overview" data-tooltip={t.profile.tab_overview} set:html={ICON_PROFILE_OVERVIEW}></button>
      <button class="profile-tab" data-tab="library" data-tooltip={t.profile.tab_library} set:html={ICON_PROFILE_LIBRARY}></button>
      <button class="profile-tab" data-tab="favorites" data-tooltip={t.profile.favorites} set:html={ICON_PROFILE_FAVORITES}></button>
      <button class="profile-tab" data-tab="stats" data-tooltip={t.profile.tab_stats} set:html={ICON_PROFILE_STATS}></button>
      <button class="profile-tab" data-tab="reviews" data-tooltip={t.profile.reviews} set:html={ICON_PROFILE_REVIEWS}></button>
      <button class="profile-tab" data-tab="lists" data-tooltip={t.profile.lists} set:html={ICON_PROFILE_LISTS}></button>
      <script is:inline>
        (function() {
          var hash = window.location.hash.replace('#', '');
          var tabs = ['overview', 'library', 'favorites', 'stats', 'reviews', 'lists'];
          if (hash && tabs.indexOf(hash) !== -1) {
            var buttons = document.querySelectorAll('.profile-tab');
            buttons.forEach(function(btn) {
              btn.classList.toggle('active', btn.dataset.tab === hash);
            });
          }
        })();
      </script>
      <script>
        import { getT } from '../i18n/client';
        function updateProfileTabTooltips() {
          const p = getT().profile;
          const tabTitles: Record<string, string> = {
            overview: p.tab_overview,
            library: p.tab_library,
            favorites: p.favorites,
            stats: p.tab_stats,
            reviews: p.reviews,
            lists: p.lists,
          };
          document.querySelectorAll('.profile-tab').forEach(btn => {
            const tab = (btn as HTMLElement).dataset.tab;
            if (tab && tabTitles[tab]) {
              btn.setAttribute('data-tooltip', tabTitles[tab]);
            }
          });
        }
        updateProfileTabTooltips();
        document.addEventListener('astro:page-load', updateProfileTabTooltips);
      </script>
    </nav>

    <div id="profile-tab-content" class="profile-tab-content">
      <div id="tab-pane-overview" class="profile-tab-pane"></div>
      <div id="tab-pane-library" class="profile-tab-pane" hidden></div>
      <div id="tab-pane-favorites" class="profile-tab-pane" hidden></div>
      <div id="tab-pane-stats" class="profile-tab-pane" hidden></div>
      <div id="tab-pane-reviews" class="profile-tab-pane" hidden></div>
      <div id="tab-pane-lists" class="profile-tab-pane" hidden></div>
    </div>

    <ProfileLibraryEditor client:load i18n={t.media} />

  </main>
</BaseLayout>

<script>
  import { getAuthToken, getAllLibraryEntries, getAllCatalogEntries } from '../lib/tauri';
  import { decodeJwtPayload } from '../lib/profile/utils';
  import { renderOverview } from '../lib/profile/render-overview';
  import { renderLibrary } from '../lib/profile/render-library';
  import { renderFavorites } from '../lib/profile/render-favorites';
  import { renderStats } from '../lib/profile/render-stats';
  import { renderReviews } from '../lib/profile/render-reviews';
  import { renderLists }   from '../lib/profile/render-lists';
  import { getImage } from '../lib/storage/images';
  import { getFontFile } from '../lib/settings/fonts';
  import { STORAGE_KEYS } from '../lib/shared/storage-keys';
  import { getCachedLibraryAndCatalog } from '../lib/profile/library-data-cache';

  (document.getElementById('auth-modal') as HTMLDialogElement | null)?.close();

  const TABS = ['overview', 'library', 'favorites', 'stats', 'reviews', 'lists'] as const;
  type Tab = typeof TABS[number];

  function getTabFromHash(): Tab {
    const h = location.hash.replace('#', '') as Tab;
    return TABS.includes(h) ? h : 'overview';
  }

  let cachedItems: Awaited<ReturnType<typeof getAllLibraryEntries>> = [];
  let cachedCatalog: Awaited<ReturnType<typeof getAllCatalogEntries>> = [];
  let activeTab: Tab = getTabFromHash();

  // Every tab gets its own permanent pane (see the template above) instead
  // of sharing one container that gets torn down and rebuilt per switch —
  // all six are rendered once, up front (see init below), and switching
  // tabs after that is just a visibility toggle: no re-render, no async
  // gap, no blank flash while the new tab's data/DOM builds.
  function getPanes(): Record<Tab, HTMLElement | null> {
    return {
      overview:  document.getElementById('tab-pane-overview'),
      library:   document.getElementById('tab-pane-library'),
      favorites: document.getElementById('tab-pane-favorites'),
      stats:     document.getElementById('tab-pane-stats'),
      reviews:   document.getElementById('tab-pane-reviews'),
      lists:     document.getElementById('tab-pane-lists'),
    };
  }

  function switchTab(tab: Tab) {
    activeTab = tab;
    // Preserves whatever state object Astro's ClientRouter already attached
    // to this history entry ({index, scrollX, scrollY} — see
    // node_modules/astro/dist/transitions/router.js) instead of clobbering
    // it to null. A null state makes the router's own popstate handler
    // silently no-op on that entry (`if (ev.state === null) return;`),
    // which made browser Back appear to skip straight past Profile/Search
    // to whatever entry before them still had real state.
    history.replaceState(history.state, '', tab === 'overview' ? '/profile' : `/profile#${tab}`);

    document.querySelectorAll<HTMLButtonElement>('.profile-tab').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === tab);
    });

    const panes = getPanes();
    for (const [key, pane] of Object.entries(panes)) {
      if (pane) pane.hidden = key !== tab;
    }
  }

  async function init() {
    // Bail out if profile tab content is not present
    if (!document.getElementById('profile-tab-content')) return;

    // Re-read on every navigation to this page, not just once at module load
    // — Astro's view-transition navigation re-fires 'astro:page-load' and
    // re-runs init(), but doesn't re-evaluate this script module's top-level
    // `let activeTab = getTabFromHash()`. Without this, clicking a navbar
    // media-type link (which deep-links to /profile?libtype=<type>#library)
    // while already on Profile silently kept whatever tab was active before,
    // ignoring the new #library hash in the URL.
    activeTab = getTabFromHash();

    // The navbar's per-type library shortcuts (Navbar.astro) deep-link here
    // as /profile?libtype=<type>#library. switchTab()'s own replaceState
    // call below strips that query string from the URL before LibrarySection
    // ever mounts, so it can't just read location.search — stash it here,
    // before switchTab runs, for LibrarySection to pick up once and discard.
    const pendingLibType = new URLSearchParams(location.search).get('libtype');
    if (pendingLibType) sessionStorage.setItem(STORAGE_KEYS.pendingLibraryType, pendingLibType);

    // Immediately cache profile path to make reloads solid
    localStorage.setItem(STORAGE_KEYS.lastVisitedPath, window.location.pathname + window.location.search + window.location.hash);

    // A real change of section — the search page should start fresh next time.
    sessionStorage.removeItem(STORAGE_KEYS.searchState);

    const session = await getAuthToken().catch(() => null);
    if (!session?.token) { window.location.replace('/login'); return; }

    const payload  = decodeJwtPayload(session.token);
    const avatar   = payload.avatar as string | null;

    // A custom display name set in Settings > Apariencia takes priority over
    // the raw username picked at login — fetched here (not just below for the
    // font) so every use of "the user's name" on this page reflects it,
    // not just the login-time username. Runs in parallel with the banner/
    // avatar image lookups below since none of these three depend on each
    // other's result.
    const [userInfo, customBanner, customAvatar] = await Promise.all([
      import('../lib/tauri').then(m => m.getUserInfo()).catch(() => ({} as Record<string, unknown>)),
      getImage(STORAGE_KEYS.profileBannerCustom),
      getImage(STORAGE_KEYS.profileAvatarCustom),
    ]);
    const username = (userInfo.display_name as string | undefined)?.trim() || session.username;

    // Custom banner image
    const bannerEl = document.querySelector('.profile-banner') as HTMLElement | null;
    if (bannerEl && customBanner) {
      const currentBg = bannerEl.style.backgroundImage;
      if (!currentBg || (!currentBg.includes(customBanner))) {
        bannerEl.style.backgroundImage = `url('${customBanner}')`;
        bannerEl.style.backgroundSize = 'cover';
        bannerEl.style.backgroundPosition = 'center';
        bannerEl.classList.add('has-custom-bg');
      }
      try { localStorage.setItem('profile_banner_cache', customBanner); } catch {}
    }

    // Custom avatar takes priority over Google avatar
    const avatarSrc = customAvatar || avatar;
    if (avatarSrc) {
      try { localStorage.setItem('profile_avatar_cache', avatarSrc); } catch {}
    }
    if (username) {
      try { localStorage.setItem('profile_username_cache', username); } catch {}
    }

    const bannerContent = document.getElementById('banner-content');
    if (bannerContent) {
      const avatarHtml = avatarSrc
        ? `<img class="profile-avatar" src="${avatarSrc}" alt="${username}" referrerpolicy="no-referrer">`
        : `<div class="profile-avatar-placeholder">${(username[0] ?? '?').toUpperCase()}</div>`;

      const fontId = (userInfo.font as string | undefined) ?? 'inter';
      localStorage.setItem('profile_font_cache', fontId);
      const fontSrc = getFontFile(fontId);
      const fontFamily = `pf-${fontId}`;
      if (fontSrc) {
        const s = document.createElement('style');
        // Unique family name per font — see the inline early-paint script's
        // own comment above for why a shared "profile-font" name doesn't
        // reliably force a repaint when you switch fonts in Settings.
        s.textContent = `@font-face { font-family: "${fontFamily}"; src: url("/fonts/${fontSrc}") format("woff2"); font-display: swap; }`;
        document.head.appendChild(s);
      }

      const newHTML = `${avatarHtml}<h1 class="profile-username-large" style="font-family: '${fontFamily}', sans-serif;">${username}</h1>`;
      const norm = (h) => h.replace(/\s+/g, ' ').replace(/'/g, '"').trim();
      if (norm(bannerContent.innerHTML) !== norm(newHTML)) {
        bannerContent.innerHTML = newHTML;
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.profile-tab').forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.dataset.tab as Tab));
    });

    ({ items: cachedItems, catalog: cachedCatalog } = await getCachedLibraryAndCatalog());

    // Mount every tab's content up front, in parallel, instead of one at a
    // time as each is first visited — switchTab below then only ever
    // toggles which already-rendered pane is visible. Set the initial
    // visibility right away so a slow tab doesn't hold up a fast one being
    // shown/hidden correctly.
    const panes = getPanes();
    switchTab(activeTab);

    // Each pane fades in on its own the moment ITS render resolves, not
    // once every tab is ready — a fast tab (Library/Favorites, already-
    // cached data) shouldn't sit invisible waiting on a slower one
    // (Overview, several IPC round trips deep) just because they share one
    // wrapper. Never re-triggered afterwards, so switching tabs (a plain
    // visibility toggle between already-rendered panes) never replays it.
    function fadeInWhenReady(pane: HTMLElement | null, render: () => Promise<void>): Promise<void> {
      if (!pane) return Promise.resolve();
      return render().then(() => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            pane.classList.add('pane-ready');
          });
        });
      });
    }

    await Promise.all([
      fadeInWhenReady(panes.overview,  () => renderOverview(panes.overview!, cachedItems, cachedCatalog)),
      fadeInWhenReady(panes.library,   () => renderLibrary(panes.library!)),
      fadeInWhenReady(panes.favorites, () => renderFavorites(panes.favorites!)),
      fadeInWhenReady(panes.stats,     () => renderStats(panes.stats!)),
      fadeInWhenReady(panes.reviews,   () => renderReviews(panes.reviews!)),
      fadeInWhenReady(panes.lists,     () => renderLists(panes.lists!)),
    ]);

    // Delegate clicks: card body → open editor in modal, cover <a> handles its own navigation
    document.getElementById('profile-tab-content')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.library-card-thumb')) return;

      const card = (e.target as HTMLElement).closest<HTMLElement>('.library-card[data-id]');
      if (!card) return;

      const extId = card.dataset.id;
      const libraryEntry = cachedItems.find(item => item.external_id === extId);
      const catalogEntry = cachedCatalog.find(item => item.external_id === extId);

      if (extId && libraryEntry && catalogEntry) {
        window.dispatchEvent(new CustomEvent('open-profile-editor', {
          detail: {
            externalId: extId,
            libraryEntry,
            catalogEntry
          }
        }));
      }
    });

    // LibrarySection listens for this same event itself and re-fetches in
    // place — re-rendering it from here too used to unmount/remount the
    // whole tab (every card, every filter) for a single field change,
    // flashing the whole grid. Still refreshed here since cachedItems feeds
    // the click-to-open-editor lookup below, independent of which tab (if
    // any) is currently showing the library.
    window.addEventListener('refresh-profile-library', async () => {
      // library-data-cache.ts's own listener (registered on import, above
      // this one) already invalidated the shared cache by the time this
      // runs, so this repopulates it with a fresh fetch rather than issuing
      // a second, redundant one.
      ({ items: cachedItems } = await getCachedLibraryAndCatalog());

      // Overview's Hall of Fame/recent-activity recap doesn't self-refresh
      // the way LibrarySection does — now that every tab stays mounted
      // instead of remounting on next visit, it'd otherwise sit stale for
      // the rest of the session after any library edit made elsewhere.
      const overviewPane = document.getElementById('tab-pane-overview');
      if (overviewPane) await renderOverview(overviewPane, cachedItems, cachedCatalog);
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
