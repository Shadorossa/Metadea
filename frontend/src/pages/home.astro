---
import "../styles/pages/home.css";
import "../styles/components/yearly-bingo.css";
import "../styles/pages/media/editor/search.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLang, useTranslations } from "../i18n/index";
import { ActivityFeedSection } from "../components/home/ActivityFeedSection";
import { CurrentlySection } from "../components/home/CurrentlySection";
import { FinishAnniversaryBanner } from "../components/home/FinishAnniversaryBanner";
import { CalendarSection } from "../components/home/CalendarSection";
import { BingoHomeSection } from "../components/bingo/BingoHomeSection";
import AnniversarySkeleton from "../components/home/skeletons/AnniversarySkeleton.astro";
import CurrentlySkeleton from "../components/home/skeletons/CurrentlySkeleton.astro";
import CalendarSkeleton from "../components/home/skeletons/CalendarSkeleton.astro";
import ActivityFeedSkeleton from "../components/home/skeletons/ActivityFeedSkeleton.astro";
import HomeRailSkeleton from "../components/home/skeletons/HomeRailSkeleton.astro";
import { HomeRail } from "../components/home/HomeRail";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="Metadea" lang={lang} activePage="home">
  <main class="home-page-container">
    <!-- Pre-paint layout hint (lib/home/home-snapshot.ts writes it): reserves
         the anniversary block, the "currently" groups, the feed cards and
         the right rail's cards the last visit had, and this month's
         calendar week count, before any module loads. -->
    <script is:inline>
      (function () {
        const d = document.documentElement;
        d.removeAttribute("data-home-anniv");
        d.removeAttribute("data-home-currently");
        d.removeAttribute("data-home-feed");
        d.removeAttribute("data-home-feed-paged");
        d.removeAttribute("data-home-continue");
        try {
          const n = new Date();
          const pad = (x) => (x < 10 ? "0" : "") + x;
          const today = n.getFullYear() + "-" + pad(n.getMonth() + 1) + "-" + pad(n.getDate());
          const first = new Date(n.getFullYear(), n.getMonth(), 1);
          const days = new Date(n.getFullYear(), n.getMonth() + 1, 0).getDate();
          d.setAttribute("data-home-cal-rows", String(Math.ceil(((first.getDay() + 6) % 7 + days) / 7)));
          const h = JSON.parse(localStorage.getItem('metadea_home_layout') || "null");
          if (h && h.d === today && h.a > 0) d.setAttribute("data-home-anniv", "");
          if (h && h.g > 0) d.setAttribute("data-home-currently", String(Math.min(h.g, 8)));
          if (h && h.f > 0) d.setAttribute("data-home-feed", String(Math.min(h.f, 10)));
          if (h && h.fp > 0) d.setAttribute("data-home-feed-paged", "");
          if (h && h.c > 0) d.setAttribute("data-home-continue", "");
        } catch {
          // No hint: the sections simply start empty.
        }
      })();
    </script>

    <div
      id="google-link-container"
      class="animate-fade-in"
      style="display: none; justify-content: center; width: 100%;"
    >
      <a
        id="home-google-btn"
        class="google-btn"
        href="#"
        style="width: 220px !important; max-width: 220px !important; flex: 0 0 auto !important; margin: 0 auto; display: flex; justify-content: center;"
      >
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path
            fill="#FFC107"
            d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 2.9l5.7-5.7C34.5 6.5 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.9z"
          ></path>
          <path
            fill="#FF3D00"
            d="M6.3 14.7l6.6 4.8C14.7 16.1 19 13 24 13c3.1 0 5.8 1.1 8 2.9l5.7-5.7C34.5 6.5 29.5 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
          ></path>
          <path
            fill="#4CAF50"
            d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.3 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8H6.3C9.7 36.5 16.3 44 24 44z"
          ></path>
          <path
            fill="#1976D2"
            d="M43.6 20.1H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.3 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.7-.4-3.9z"
          ></path>
        </svg>
        <span id="home-google-btn-text" data-i18n="auth.link_google">{t.auth.link_google}</span>
      </a>
    </div>

    <!-- The grid keeps its own width; the rail sits in the right gutter
         when there is one, else stacks below (home.css, .home-layout). -->
    <div class="home-layout">
      <div class="home-content-grid">
        <div class="home-main-col">
          <CurrentlySection client:only="react">
            <CurrentlySkeleton slot="fallback" />
          </CurrentlySection>
          <div class="home-calendar-section">
            <CalendarSection client:only="react">
              <CalendarSkeleton slot="fallback" p={t.profile} />
            </CalendarSection>
          </div>
          <!-- Yearly Bingo: result/create cards Dec 19 – Jan 10, the current board (view-only) the rest of the year. -->
          <BingoHomeSection client:only="react" />
        </div>

        <aside class="home-side-col">
          <FinishAnniversaryBanner client:only="react">
            <AnniversarySkeleton slot="fallback" heading={t.home.anniversary_heading} />
          </FinishAnniversaryBanner>
          <section class="home-activity-section">
            <ActivityFeedSection client:only="react">
              <ActivityFeedSkeleton slot="fallback" title={t.profile.recent_activity} p={t.profile} />
            </ActivityFeedSection>
          </section>
        </aside>
      </div>

      <aside class="home-rail">
        <HomeRail client:only="react">
          <HomeRailSkeleton
            slot="fallback"
            continueHeading={t.home.continue_heading}
            airingHeading={t.home.airing_heading}
          />
        </HomeRail>
      </aside>
    </div>

    <aside
      id="home-profile-sync-prompt"
      class="home-profile-sync-prompt"
      aria-labelledby="home-profile-sync-title"
      hidden
    >
      <div class="home-profile-sync-copy">
        <h2 id="home-profile-sync-title" data-i18n="home.profile_sync_prompt">{t.home.profile_sync_prompt}</h2>
        <p id="home-profile-sync-status" class="home-profile-sync-status" aria-live="polite"></p>
      </div>
      <button id="home-profile-sync-button" class="btn btn--accent home-profile-sync-action" type="button" data-i18n="home.profile_sync_button">
        {t.home.profile_sync_button}
      </button>
      <button
        id="home-profile-sync-dismiss"
        class="home-profile-sync-dismiss"
        type="button"
        aria-label={t.home.profile_sync_dismiss}
        title={t.home.profile_sync_dismiss}
        data-i18n-aria-label="home.profile_sync_dismiss"
        data-i18n-title="home.profile_sync_dismiss"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </aside>
  </main>

  <script>
    import { getAuthToken } from "../lib/tauri";
    import { API_URL } from "../lib/api/urls";
    import { refreshGeneralActivityFeed } from "../lib/social/activity-feed";
    import { STORAGE_KEYS } from "../lib/storage/storage-keys";
    import { getT } from "../i18n/runtime";

    // Server-rendered text follows the UI locale through its data-i18n*
    // attributes (components/i18n/LocaleBootstrap.astro); only the sync
    // button's runtime states are set here.
    const ht = getT();

    async function checkSession() {
      const session = await getAuthToken().catch(() => null);
      const prompt = document.getElementById("home-profile-sync-prompt");
      const syncButton = document.getElementById("home-profile-sync-button") as HTMLButtonElement | null;

      if (session && session.token === "offline_token") {
        const container = document.getElementById("google-link-container");
        if (container) {
          container.style.display = "block";
        }
      }

      if (!prompt || !session?.token || session.token === "offline_token") return;

      const lastSync = Number(localStorage.getItem(STORAGE_KEYS.profileSyncLastSync));
      const lastSyncDate = Number.isFinite(lastSync) && lastSync > 0
        ? new Date(lastSync).toDateString()
        : null;
      if (lastSyncDate === new Date().toDateString()) return;

      const hidePrompt = () => {
        prompt.classList.remove("is-visible");
        window.setTimeout(() => { prompt.hidden = true; }, 180);
      };

      prompt.hidden = false;
      requestAnimationFrame(() => prompt.classList.add("is-visible"));
      // "Not now" only closes it for this visit — the prompt keeps its
      // once-a-day rule (it returns until a sync succeeds today).
      document.getElementById("home-profile-sync-dismiss")?.addEventListener("click", hidePrompt);
      syncButton?.addEventListener("click", async () => {
        if (!syncButton || syncButton.disabled) return;

        const status = document.getElementById("home-profile-sync-status");
        syncButton.disabled = true;
        prompt.setAttribute("aria-busy", "true");
        syncButton.textContent = ht.home.profile_syncing;
        if (status) status.textContent = "";

        let synced = false;
        try {
          const { syncProfileToServer } = await import("../lib/social/profile-sync");
          synced = await syncProfileToServer(true);
        } catch { /* show the same retry state for import, network, or server errors */ }

        prompt.setAttribute("aria-busy", "false");
        if (synced) {
          await refreshGeneralActivityFeed(true);
          hidePrompt();
          return;
        }

        // The server's own answer (HTTP status + message) when it replied,
        // so "check your connection" isn't the only clue on a server error.
        let detail = "";
        try {
          const last = JSON.parse(localStorage.getItem(STORAGE_KEYS.profileSyncLastAttempt) ?? "null");
          if (last?.result === "failed_response" && typeof last.detail === "string") detail = last.detail;
        } catch { /* no attempt record */ }
        if (status) status.textContent = detail ? `${ht.home.profile_sync_error} (${detail})` : ht.home.profile_sync_error;
        syncButton.textContent = ht.home.profile_sync_button;
        syncButton.disabled = false;
      });
    }

    document.addEventListener("astro:page-load", () => {
      // Landing on Home is a real change of section — the search page
      // should start fresh next time, not restore whatever was left over.
      sessionStorage.removeItem(STORAGE_KEYS.searchState);

      document
        .getElementById("home-google-btn")
        ?.addEventListener("click", (e) => {
          e.preventDefault();
          // Tells the server where to redirect back to once Google's flow
          // finishes — a plain top-level navigation like this never sends a
          // usable Origin/Referer header, so there's no other way for the
          // Worker to know whether this is a packaged build (tauri.localhost)
          // or `tauri dev` (localhost:4321).
          const origin = encodeURIComponent(window.location.origin);
          window.location.href = `${API_URL}/api/auth/google?origin=${origin}`;
        });

      checkSession();
    });
  </script>
</BaseLayout>
