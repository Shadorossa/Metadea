---
import type { Translations } from '../i18n/index';
import { ALL_MEDIA_TYPES } from '../lib/constants/media';

interface Props {
  activePage?: 'home' | 'search' | 'local' | 'notifications' | 'profile' | 'settings' | 'tier' | 'admin';
  i18n: Translations['nav'];
  typeLabels: Translations['search']['types'];
}
const { activePage, i18n, typeLabels } = Astro.props;

// Character has no place in the library shortcuts — it isn't something you
// track a personal list of the way anime/manga/games/etc. are.
const LIBRARY_TYPES = ALL_MEDIA_TYPES.filter(t => t !== 'character');
---

<header class="navbar" transition:persist="navbar" transition:name="navbar" transition:animate="none">
  <!-- Izquierda: home + play (biblioteca local) + tier -->
  <div class="nav-group nav-group--left">
    <a href="/home"   data-nav="home"   class={`nav-icon-btn nav-icon-btn--plain${activePage === 'home'   ? ' active' : ''}`} title={i18n.home}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
        <polyline points="9 21 9 12 15 12 15 21"/>
      </svg>
    </a>
    <a href="/local" data-nav="local" class={`nav-icon-btn nav-icon-btn--plain${activePage === 'local' ? ' active' : ''}`} title={i18n.local}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
      </svg>
    </a>
    <span class="nav-icon-btn nav-icon-btn--plain nav-icon-btn--tier nav-icon-btn--disabled" aria-disabled="true" title={i18n.tier}>
      <span class="nav-tier-s">S</span>
    </span>
    <a href="/search" data-nav="search" class={`nav-browse-link${activePage === 'search' ? ' active' : ''}`}>
      {i18n.browse}
    </a>
  </div>

  <!-- Centro: por defecto, biblioteca + tipos — en /local y /search se
       sustituye por las pestañas propias de esa página (portal React hacia
       #nav-center-slot, ver LocalLibrary.tsx / SearchIsland.tsx). -->
  <div class="nav-center-wrap">
    <div id="nav-center-default" class={`nav-center-text${activePage === 'local' || activePage === 'search' ? ' nav-hidden' : ''}`}>
      {LIBRARY_TYPES.map(type => (
        <a href={`/profile?libtype=${type}#library`} class="nav-text-link">
          {typeLabels[type as keyof typeof typeLabels] ?? type}
        </a>
      ))}
    </div>
    <div id="nav-center-slot" class="nav-center-slot"></div>
  </div>

  <!-- Derecha: buscar + notificaciones + avatar + ajustes -->
  <div class="nav-group nav-group--right">
    <button type="button" id="nav-quick-search-btn" class="nav-icon-btn nav-icon-btn--plain" title={i18n.browse}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"/>
        <line x1="16.5" y1="16.5" x2="22" y2="22"/>
      </svg>
    </button>
    <a
      href="/notifications"
      data-nav="notifications"
      class={`nav-icon-btn nav-icon-btn--plain${activePage === 'notifications' ? ' active' : ''}`}
      title={i18n.notifications}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
    </a>
    <a
      href="/profile"
      id="nav-account-btn"
      data-nav="account"
      class={`nav-icon-btn nav-icon-btn--avatar${activePage === 'profile' ? ' active' : ''}`}
      title={i18n.dropdown_profile}
    >
      <img id="nav-avatar-img" class="nav-avatar-img" alt="" referrerpolicy="no-referrer" style="display: none;" />
      <svg id="nav-avatar-fallback" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
        <circle cx="12" cy="8" r="4"/>
        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
      </svg>
      <script is:inline>
        // Runs synchronously during HTML parse, before the bundled
        // astro:page-load script below even loads — on a hard refresh
        // (F5) that gap was long enough to flash the fallback person icon
        // before swapping to the real avatar. Both elements start
        // display:none in the markup above so neither one flashes first;
        // this picks the right one immediately.
        (function () {
          var img = document.getElementById('nav-avatar-img');
          var fallback = document.getElementById('nav-avatar-fallback');
          var src = localStorage.getItem('profile_avatar_cache');
          if (src && img && fallback) {
            img.src = src;
            img.style.display = 'block';
          } else if (fallback) {
            fallback.style.display = 'block';
          }
        })();
      </script>
    </a>
    <a
      href="/settings"
      data-nav="settings"
      class={`nav-icon-btn nav-icon-btn--plain${activePage === 'settings' ? ' active' : ''}`}
      title={i18n.dropdown_settings}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
    </a>
  </div>
</header>

<script>
  // Routes that map to each nav icon — mirrors the activePage prop each page
  // passes to BaseLayout. Needed because the navbar is transition:persist'd
  // (it never unmounts/remounts across View Transitions navigations, which is
  // what stops it from flickering), so the server-rendered activePage classes
  // go stale after the first navigation — this recomputes them client-side.
  function computeActivePage(pathname: string): string | undefined {
    if (pathname.startsWith('/home')) return 'home';
    if (pathname.startsWith('/character')) return 'search';
    if (pathname.startsWith('/search')) return 'search';
    if (pathname.startsWith('/tier')) return 'tier';
    if (pathname.startsWith('/admin')) return 'admin';
    if (pathname.startsWith('/local')) return 'local';
    if (pathname.startsWith('/settings')) return 'settings';
    if (pathname.startsWith('/notifications')) return 'notifications';
    if (pathname.startsWith('/profile')) return 'account';
    return undefined;
  }

  import { getT } from '../i18n/client';

  function updateActiveNav() {
    const path = window.location.pathname;
    const key = computeActivePage(path);
    const navT = getT().nav;
    const titles: Record<string, string> = {
      home: navT.home,
      search: navT.browse,
      tier: navT.tier,
      local: navT.local,
      account: navT.dropdown_profile,
      settings: navT.dropdown_settings,
      notifications: navT.notifications,
    };
    document.querySelectorAll('.navbar [data-nav]').forEach(el => {
      const navKey = el.getAttribute('data-nav');
      el.classList.toggle('active', navKey === key);
      if (navKey && titles[navKey]) {
        el.setAttribute('title', titles[navKey]);
      }
    });

    // /local and /search portal their own tab bar into #nav-center-slot
    // (see LocalLibrary.tsx / SearchIsland.tsx) — hide the default
    // library/type shortcuts while that's the case so they don't double up.
    const centerDefault = document.getElementById('nav-center-default');
    if (centerDefault) {
      centerDefault.classList.toggle('nav-hidden', path.startsWith('/local') || path.startsWith('/search'));
    }

    // profile.astro caches the resolved avatar (custom or Google) here on
    // every visit so it can paint instantly next time — reused here so the
    // navbar shows the real avatar instead of the generic person icon.
    const avatarImg = document.getElementById('nav-avatar-img') as HTMLImageElement | null;
    const avatarFallback = document.getElementById('nav-avatar-fallback');
    const avatarSrc = localStorage.getItem('profile_avatar_cache');
    if (avatarImg && avatarFallback) {
      if (avatarSrc) {
        avatarImg.onerror = () => {
          avatarImg.style.display = 'none';
          (avatarFallback as HTMLElement).style.display = 'block';
        };
        avatarImg.src = avatarSrc;
        avatarImg.style.display = 'block';
        (avatarFallback as HTMLElement).style.display = 'none';
      } else {
        avatarImg.removeAttribute('src');
        avatarImg.style.display = 'none';
        (avatarFallback as HTMLElement).style.display = 'block';
      }
    }
  }

  // astro:page-load fires on initial load AND after every View Transitions
  // navigation — that's all this persisted navbar needs.
  document.addEventListener('astro:page-load', updateActiveNav);

  // The navbar itself is transition:persist'd, so this button is never
  // recreated across navigations — a one-time listener here is enough,
  // unlike updateActiveNav above which has to re-run per page-load.
  document.getElementById('nav-quick-search-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('metadea:open-quick-search'));
  });
</script>
