---
import { ICON_STAR, ICON_RATING_FACES } from "../../lib/shared/icon-strings";
import type { Translations } from "../../i18n/index";
import { LOCALES } from "../../i18n/index";

interface Props {
  t: Translations;
}
const { t } = Astro.props;

const LANGUAGE_NAMES: Record<string, string> = {
  es: 'Español', en: 'English', de: 'Deutsch', ja: '日本語',
  it: 'Italiano', fr: 'Français', ca: 'Català', ru: 'Русский',
};
---

<!-- Tab: Preferencias -->
<div class="settings-panel hidden" id="panel-preferences">
  <!-- Sistema de Calificación + Idioma -->
  <div class="settings-divider settings-divider--row">
    <div class="settings-section" style="flex: 1;">
      <h3 class="settings-section-title" data-i18n="settings.rating_system_title">
        {t.settings.rating_system_title}
      </h3>
      <div class="rating-system-picker">
        <button
          type="button"
          class="rating-system-btn"
          data-value="5-star"
          data-i18n-title="settings.rating_5star_title"
          title={t.settings.rating_5star_title}
          set:html={ICON_STAR}
        >
        </button>
        <button
          type="button"
          class="rating-system-btn"
          data-value="10-dec"
          data-i18n-title="settings.rating_10dec_title"
          title={t.settings.rating_10dec_title}
        >
          <span class="rating-value-text">10.00</span>
        </button>
        <button
          type="button"
          class="rating-system-btn"
          data-value="10"
          data-i18n-title="settings.rating_10int_title"
          title={t.settings.rating_10int_title}
        >
          <span class="rating-value-text">10</span>
        </button>
        <button
          type="button"
          class="rating-system-btn"
          data-value="3-emoji"
          data-i18n-title="settings.rating_3emoji_title"
          title={t.settings.rating_3emoji_title}
          set:html={ICON_RATING_FACES}
        >
        </button>
      </div>
    </div>

    <div class="settings-section settings-section--dual-rating" style="flex: 1;">
      <h3 class="settings-section-title" data-i18n="settings.dual_rating_section_title">
        {t.settings.dual_rating_section_title}
      </h3>
      <div class="settings-checkbox-row dual-rating-toggle-row">
        <div class="settings-checkbox-group">
          <label class="settings-checkbox-label">
            <input type="checkbox" id="dual-rating-enabled" class="settings-checkbox" />
            <span class="checkbox-label-text" data-i18n="settings.dual_rating_enable"
              >{t.settings.dual_rating_enable}</span
            >
          </label>
        </div>

        <div id="dual-rating-system-row" class="dual-rating-system-row dual-rating-config hidden">
          <div class="rating-system-picker" id="rating-system-picker-2">
            <button
              type="button"
              class="rating-system-btn-2"
              data-value="5-star"
              title={t.settings.rating_5star_title}
              set:html={ICON_STAR}
            >
            </button>
            <button
              type="button"
              class="rating-system-btn-2"
              data-value="10-dec"
              title={t.settings.rating_10dec_title}
            >
              <span class="rating-value-text">10.00</span>
            </button>
            <button
              type="button"
              class="rating-system-btn-2"
              data-value="10"
              title={t.settings.rating_10int_title}
            >
              <span class="rating-value-text">10</span>
            </button>
            <button
              type="button"
              class="rating-system-btn-2"
              data-value="3-emoji"
              title={t.settings.rating_3emoji_title}
              set:html={ICON_RATING_FACES}
            >
            </button>
          </div>

          <!-- Only meaningful for the '10-dec'/'10' systems (a numeric
               range) — toggled by dual-rating.ts alongside the picker. -->
          <div id="dual-rating-range-row" class="dual-rating-range-row hidden">
            <div class="dual-rating-field">
              <input
                type="number"
                id="rating-2-min"
                class="settings-modal-input"
                placeholder={t.settings.dual_rating_min_label}
                step="1"
              />
            </div>
            <div class="dual-rating-field">
              <input
                type="number"
                id="rating-2-max"
                class="settings-modal-input"
                placeholder={t.settings.dual_rating_max_label}
                step="1"
              />
            </div>
          </div>
        </div>
      </div>

      <div id="dual-rating-config" class="dual-rating-config hidden">
        <div class="dual-rating-name-row">
          <div class="dual-rating-field">
            <input
              type="text"
              id="rating-name-1"
              class="settings-modal-input"
              placeholder={t.settings.dual_rating_name1_label}
              maxlength="20"
            />
          </div>
          <div class="dual-rating-field">
            <input
              type="text"
              id="rating-name-2"
              class="settings-modal-input"
              placeholder={t.settings.dual_rating_name2_label}
              maxlength="20"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="settings-section" style="flex: 1;">
      <h3 class="settings-section-title" data-i18n="settings.language_section_title">
        {t.settings.language_section_title}
      </h3>
      <div class="language-picker" id="language-picker">
        {LOCALES.map((code) => (
          <button
            type="button"
            class="language-btn"
            data-value={code}
            title={LANGUAGE_NAMES[code] ?? code}
          >
            {code.toUpperCase()}
          </button>
        ))}
      </div>
      <p class="settings-hint" data-i18n="settings.language_hint">
        {t.settings.language_hint}
      </p>
    </div>
  </div>

  <!-- Biblioteca + Contenido -->
  <div class="settings-divider settings-divider--row">
    <div class="settings-section" style="flex: 1;">
      <h3 class="settings-section-title" data-i18n="settings.library_section_title">
        {t.settings.library_section_title}
      </h3>
      <div class="settings-checkbox-row">
        <div class="settings-checkbox-group">
          <label class="settings-checkbox-label">
            <input
              type="checkbox"
              id="activity-batch-episodes"
              class="settings-checkbox"
            />
            <span class="checkbox-label-text" data-i18n="settings.activity_batch_episodes"
              >{t.settings.activity_batch_episodes}</span
            >
          </label>
          <p class="settings-hint" data-i18n="settings.activity_batch_episodes_hint">
            {t.settings.activity_batch_episodes_hint}
          </p>
        </div>
      </div>
    </div>

    <div class="settings-section" style="flex: 1;">
      <h3 class="settings-section-title" data-i18n="settings.content_section_title">
        {t.settings.content_section_title}
      </h3>
      <div class="settings-checkbox-row">
        <div class="settings-checkbox-group">
          <label class="settings-checkbox-label">
            <input
              type="checkbox"
              id="activity-adult-content"
              class="settings-checkbox"
            />
            <span class="checkbox-label-text" data-i18n="settings.activity_adult_content"
              >{t.settings.activity_adult_content}</span
            >
          </label>
          <p class="settings-hint" data-i18n="settings.activity_adult_content_hint">
            {t.settings.activity_adult_content_hint}
          </p>
        </div>
        <div class="settings-checkbox-group">
          <button
            type="button"
            id="clear-all-notes-btn"
            class="settings-danger-btn"
            data-i18n="settings.clear_notes_btn"
          >
            {t.settings.clear_notes_btn}
          </button>
          <p class="settings-hint" data-i18n="settings.clear_notes_hint">
            {t.settings.clear_notes_hint}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Confirmación: eliminar todas las notas -->
<div class="settings-help-modal hidden" id="clear-notes-modal">
  <div class="settings-help-modal-overlay"></div>
  <div class="settings-help-modal-content settings-danger-modal-content">
    <div class="settings-help-modal-header">
      <h3 data-i18n="settings.clear_notes_confirm_title">{t.settings.clear_notes_confirm_title}</h3>
      <button type="button" class="settings-help-modal-close" id="clear-notes-modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="settings-help-modal-body">
      <p data-i18n="settings.clear_notes_confirm_warning">{t.settings.clear_notes_confirm_warning}</p>
      <div class="settings-danger-modal-actions">
        <button type="button" class="settings-btn-cancel" id="clear-notes-cancel-btn" data-i18n="settings.clear_notes_cancel">
          {t.settings.clear_notes_cancel}
        </button>
        <button type="button" class="settings-btn-danger-confirm" id="clear-notes-confirm-btn" disabled>
          {t.settings.clear_notes_confirm_yes}
        </button>
      </div>
    </div>
  </div>
</div>
