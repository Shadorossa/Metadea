---
import type { Translations } from "../../i18n/index";

interface Props {
  t: Translations;
  onboarding?: boolean;
}
const { t } = Astro.props;
---

<!-- Tab: Entorno -->
<div class="settings-panel hidden" id="panel-environment">
  <div class="settings-section" data-onboarding-part="api-keys">
    <h3 class="settings-section-title" data-i18n="settings.env_title">{t.settings.env_title}</h3>

    <!-- API Platforms Selector Bar -->
    <div class="api-platforms-selector">
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="igdb" data-i18n-title="settings.env_platform_igdb_title" title={t.settings.env_platform_igdb_title}>
          <img class="api-platform-logo" src="/API/IGDB_logo.png" alt="IGDB" />
        </button>
        <span class="api-platform-label" data-i18n="settings.env_platform_games_label">{t.settings.env_platform_games_label}</span>
      </div>
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="tmdb" data-i18n-title="settings.env_platform_tmdb_title" title={t.settings.env_platform_tmdb_title}>
          <img class="api-platform-logo" src="/API/Tmdb.new.logo.png" alt="TMDB" />
        </button>
        <span class="api-platform-label" data-i18n="settings.env_platform_movies_label">{t.settings.env_platform_movies_label}</span>
      </div>
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="steam" data-i18n-title="settings.env_platform_steam_title" title={t.settings.env_platform_steam_title}>
          <img class="api-platform-logo" src="/platforms/steam_logo.png" alt="Steam" />
        </button>
        <span class="api-platform-label">Steam</span>
      </div>
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="anilist" data-i18n-title="settings.env_platform_anilist_title" title={t.settings.env_platform_anilist_title}>
          <img class="api-platform-logo" src="/API/Anilist_logo.png" alt="AniList" />
        </button>
        <span class="api-platform-label" data-i18n="settings.env_platform_anime_label">{t.settings.env_platform_anime_label}</span>
      </div>
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="mal" data-i18n-title="mal.env_platform_title" title={t.mal.env_platform_title}>
          <img class="api-platform-logo" src="/API/MyAnimeList_logo.svg" alt="MyAnimeList" />
        </button>
        <span class="api-platform-label" data-i18n="mal.env_platform_label">{t.mal.env_platform_label}</span>
      </div>
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="comicvine" data-i18n-title="settings.env_platform_comicvine_title" title={t.settings.env_platform_comicvine_title}>
          <svg class="api-platform-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 3h13l3 3v15H4z"/>
            <path d="M17 3v3h3"/>
            <line x1="7" y1="9" x2="15" y2="9"/>
            <line x1="7" y1="13" x2="15" y2="13"/>
            <line x1="7" y1="17" x2="12" y2="17"/>
          </svg>
        </button>
        <span class="api-platform-label" data-i18n="settings.env_platform_comics_label">{t.settings.env_platform_comics_label}</span>
      </div>
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="apisports" data-i18n-title="settings.env_platform_apisports_title" title={t.settings.env_platform_apisports_title}>
          <svg class="api-platform-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M7 14h3m4 0h3m-10 4h3"/>
          </svg>
        </button>
        <span class="api-platform-label" data-i18n="settings.env_platform_events_label">{t.settings.env_platform_events_label}</span>
      </div>
      <div class="api-platform-item">
        <button type="button" class="api-platform-tab-btn" data-platform="retroachievements" data-i18n-title="retro_achievements.settings_platform_title" title={t.retro_achievements.settings_platform_title}>
          <svg class="api-platform-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/>
          </svg>
        </button>
        <span class="api-platform-label" data-i18n="retro_achievements.settings_platform_label">{t.retro_achievements.settings_platform_label}</span>
      </div>
    </div>

    <!-- API Keys Safe Content Viewport -->
    <div class="api-keys-viewport">

      <!-- State: None selected (Default) -->
      <div class="api-keys-empty-placeholder" id="api-keys-placeholder">
        <span class="api-keys-placeholder-icon">🔑</span>
        <h4 data-i18n="settings.env_platform_empty_title">{t.settings.env_platform_empty_title}</h4>
        <p data-i18n="settings.env_platform_empty_hint">{t.settings.env_platform_empty_hint}</p>
      </div>

      <!-- Form: IGDB -->
      <div class="api-platform-form-block hidden" id="api-form-igdb">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">Twitch / IGDB API</span>
          <button type="button" class="settings-help-btn api-help-btn" data-help="igdb" title={t.settings.env_igdb_help_title} data-i18n-title="settings.env_igdb_help_title">
            <span class="info-indicator" aria-hidden="true">i</span>
          </button>
        </div>
        <div class="env-fields env-fields--row">
          <div class="env-field">
            <label class="env-label" for="igdb-client-id" data-i18n="settings.env_igdb_client_id">{t.settings.env_igdb_client_id}</label>
            <input
              class="env-input"
              type="text"
              id="igdb-client-id"
              placeholder="xxxxxxxxxxxxxxxxxxxxxxxx"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
          <div class="env-field">
            <label class="env-label" for="igdb-client-secret" data-i18n="settings.env_igdb_client_secret">{t.settings.env_igdb_client_secret}</label>
            <input
              class="env-input"
              type="password"
              id="igdb-client-secret"
              placeholder="••••••••••••••••••••••••"
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Form: TMDB -->
      <div class="api-platform-form-block hidden" id="api-form-tmdb">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">TheMovieDB API</span>
          <button type="button" class="settings-help-btn api-help-btn" data-help="tmdb" title={t.settings.env_tmdb_help_title} data-i18n-title="settings.env_tmdb_help_title">
            <span class="info-indicator" aria-hidden="true">i</span>
          </button>
        </div>
        <div class="env-fields env-fields--row">
          <div class="env-field">
            <label class="env-label" for="tmdb-access-token" data-i18n="settings.env_tmdb_access_token">{t.settings.env_tmdb_access_token}</label>
            <input
              class="env-input"
              type="password"
              id="tmdb-access-token"
              placeholder="••••••••••••••••••••••••••••••••"
              autocomplete="off"
            />
          </div>
          <div class="env-field">
            <label class="env-label" for="tmdb-api-key" data-i18n="settings.env_tmdb_api_key">{t.settings.env_tmdb_api_key}</label>
            <input
              class="env-input"
              type="password"
              id="tmdb-api-key"
              placeholder="••••••••••••••••••••••••••••••••"
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Form: Steam -->
      <div class="api-platform-form-block hidden" id="api-form-steam">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">Steam Web API</span>
          <button type="button" class="settings-help-btn api-help-btn" data-help="steam" title={t.settings.env_steam_help_title} data-i18n-title="settings.env_steam_help_title">
            <span class="info-indicator" aria-hidden="true">i</span>
          </button>
        </div>
        <div class="env-fields">
          <div class="env-field">
            <label class="env-label" for="steam-api-key" data-i18n="settings.env_steam_api_key">{t.settings.env_steam_api_key}</label>
            <input
              class="env-input"
              type="password"
              id="steam-api-key"
              placeholder="••••••••••••••••••••••••••••••••"
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Form: AniList -->
      <div class="api-platform-form-block hidden" id="api-form-anilist">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">AniList Developer API</span>
          <button type="button" class="settings-help-btn api-help-btn" data-help="anilist" title={t.settings.env_anilist_help_title} data-i18n-title="settings.env_anilist_help_title">
            <span class="info-indicator" aria-hidden="true">i</span>
          </button>
        </div>
        <div class="env-fields">
          <div class="env-field">
            <label class="env-label" for="anilist-client-id">Client ID</label>
            <input
              class="env-input"
              type="text"
              id="anilist-client-id"
              placeholder={t.settings.env_anilist_client_id_ph} data-i18n-placeholder="settings.env_anilist_client_id_ph"
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Form: MyAnimeList (OAuth client id; the login itself is in Conexiones) -->
      <div class="api-platform-form-block hidden" id="api-form-mal">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">MyAnimeList API</span>
          <button type="button" class="settings-help-btn api-help-btn" data-help="mal" title={t.mal.env_help_title} data-i18n-title="mal.env_help_title" aria-label={t.mal.env_help_title} data-i18n-aria-label="mal.env_help_title">
            <span class="info-indicator" aria-hidden="true">i</span>
          </button>
        </div>
        <div class="env-fields">
          <div class="env-field">
            <label class="env-label" for="mal-client-id">Client ID</label>
            <input
              class="env-input"
              type="text"
              id="mal-client-id"
              placeholder={t.mal.env_client_id_ph} data-i18n-placeholder="mal.env_client_id_ph"
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Form: Comic Vine -->
      <div class="api-platform-form-block hidden" id="api-form-comicvine">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">Comic Vine API</span>
          <button type="button" class="settings-help-btn api-help-btn" data-help="comicvine" title={t.settings.env_comicvine_help_title} data-i18n-title="settings.env_comicvine_help_title">
            <span class="info-indicator" aria-hidden="true">i</span>
          </button>
        </div>
        <div class="env-fields">
          <div class="env-field">
            <label class="env-label" for="comicvine-api-key">API Key</label>
            <input
              class="env-input"
              type="password"
              id="comicvine-api-key"
              placeholder="••••••••••••••••••••••••••••••••"
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Form: API-Sports -->
      <div class="api-platform-form-block hidden" id="api-form-apisports">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">API-Sports</span>
          <button type="button" class="settings-help-btn api-help-btn" data-help="apisports" title={t.settings.env_apisports_help_title} data-i18n-title="settings.env_apisports_help_title">
            <span class="info-indicator" aria-hidden="true">i</span>
          </button>
        </div>
        <div class="env-fields">
          <div class="env-field">
            <label class="env-label" for="apisports-api-key" data-i18n="settings.env_apisports_api_key">{t.settings.env_apisports_api_key}</label>
            <input class="env-input" type="password" id="apisports-api-key" placeholder="API key" autocomplete="off" />
          </div>
        </div>
      </div>

      <!-- Form: RetroAchievements -->
      <div class="api-platform-form-block hidden" id="api-form-retroachievements">
        <div class="env-service-header env-service-header--api">
          <span class="api-form-service-title">RetroAchievements</span>
          <a class="settings-hint" href="https://retroachievements.org/settings" target="_blank" rel="noopener noreferrer" data-i18n="retro_achievements.settings_get_key">{t.retro_achievements.settings_get_key}</a>
        </div>
        <div class="env-fields env-fields--row">
          <div class="env-field">
            <label class="env-label" for="ra-username" data-i18n="retro_achievements.settings_username">{t.retro_achievements.settings_username}</label>
            <input class="env-input" type="text" id="ra-username" autocomplete="off" spellcheck="false" />
          </div>
          <div class="env-field">
            <label class="env-label" for="ra-api-key" data-i18n="retro_achievements.settings_api_key">{t.retro_achievements.settings_api_key}</label>
            <input class="env-input" type="password" id="ra-api-key" placeholder="••••••••••••••••••••••••" autocomplete="off" />
          </div>
        </div>
        <p class="settings-hint" data-i18n="retro_achievements.settings_note">{t.retro_achievements.settings_note}</p>
      </div>

    </div>

    <div class="settings-divider settings-divider--actions env-actions-center">
      <button class="btn btn--primary" id="env-save-btn" data-i18n="settings.env_save"
        >{t.settings.env_save}</button
      >
      <button class="btn btn--ghost" id="env-clear-btn" data-i18n="settings.env_clear"
        >{t.settings.env_clear}</button
      >
    </div>
  </div>

  <!-- Local Routes -->
  <div class="settings-section env-local-routes" data-onboarding-part="local-routes">
    <h3 class="settings-section-title" data-i18n="settings.local_routes_title">{t.settings.local_routes_title}</h3>
    <p class="settings-hint" data-i18n="settings.local_routes_hint">{t.settings.local_routes_hint}</p>
    <div id="local-routes-list" class="local-routes-list">
      <!-- Populated by JS -->
    </div>
    <button
      class="btn btn--sm btn--ghost env-open-folder-btn"
      id="open-env-folder-btn"
    >
      📁 <span data-i18n="settings.env_open_folder">{t.settings.env_open_folder}</span>
    </button>
  </div>

</div>
