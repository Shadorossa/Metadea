---
// Settings › Plugins: one block per kind of extension (a heading and a short
// description over its own controls). "Plugins" are code packages that run
// isolated in workers (components/plugins, docs/PLUGINS.md); "Themes" are
// the CSS skins (components/ui-themes, docs/THEMING.md).
import type { Translations } from "../../i18n/index";
import { UiThemesSection } from "../ui-themes/UiThemesSection";
import { PluginsSection } from "../plugins/PluginsSection";
import "../../styles/components/ui-themes.css";
import "../../styles/components/plugins.css";

interface Props {
  t: Translations;
}
const { t } = Astro.props;
---

<div class="settings-panel hidden" id="panel-plugins">
  <div class="settings-section">
    <h3 class="settings-section-title" data-i18n="plugins.tab">{t.plugins.tab}</h3>
    <p class="settings-hint" data-i18n="plugins.intro">{t.plugins.intro}</p>
  </div>

  <section class="settings-divider settings-plugin-category" aria-labelledby="plugins-code-title" data-plugin-category="plugins">
    <div class="settings-section">
      <h3 class="settings-section-title" id="plugins-code-title" data-i18n="plugins.plugins_title">
        {t.plugins.plugins_title}
      </h3>
      <p class="settings-hint" data-i18n="plugins.plugins_description">{t.plugins.plugins_description}</p>
      <PluginsSection client:load />
    </div>
  </section>

  <section class="settings-divider settings-plugin-category" aria-labelledby="plugins-ui-themes-title" data-plugin-category="ui_themes">
    <div class="settings-section">
      <h3 class="settings-section-title" id="plugins-ui-themes-title" data-i18n="plugins.ui_themes_title">
        {t.plugins.ui_themes_title}
      </h3>
      <p class="settings-hint" data-i18n="plugins.ui_themes_description">{t.plugins.ui_themes_description}</p>
      <UiThemesSection client:load />
    </div>
  </section>
</div>
