---
import type { Translations } from "../../i18n/index";

interface Props {
  t: Translations;
}
const { t } = Astro.props;

const COMPANIES = [
  {
    id: 'nintendo',
    name: 'Nintendo',
    logo: '/platforms/nintendo_logo.png',
    color: '#e60012',
    platforms: [
      { id: 'gamecube', name: 'GameCube', logo: '/platforms/Emu/Gamecube_logo.png' },
      { id: 'ds', name: 'Nintendo DS', logo: '/platforms/Emu/NintendoDS_logo.png' },
      { id: 'wii', name: 'Nintendo Wii', logo: '/platforms/Emu/Wii_logo.png' },
      { id: '3ds', name: 'Nintendo 3DS', logo: '/platforms/Emu/3ds_logo.png' },
      { id: 'wiiu', name: 'Wii U', logo: '/platforms/Emu/Wii_U_logo.png' },
      { id: 'switch', name: 'Nintendo Switch', logo: '/platforms/Emu/NSwitch_logo.png' },
    ]
  },
  {
    id: 'playstation',
    name: 'PlayStation',
    logo: '/platforms/playstation_logo.png',
    color: '#003087',
    platforms: [
      { id: 'ps1', name: 'PlayStation 1', logo: '/platforms/Emu/PS1_logo.png' },
      { id: 'ps2', name: 'PlayStation 2', logo: '/platforms/Emu/PS2_logo.png' },
      { id: 'psp', name: 'PlayStation Portable', logo: '/platforms/Emu/Psp_logo.png' },
      { id: 'ps3', name: 'PlayStation 3', logo: '/platforms/Emu/PS3_logo.png' },
      { id: 'psvita', name: 'PlayStation Vita', logo: '/platforms/Emu/PSVita_logo.png' },
      { id: 'ps4', name: 'PlayStation 4', logo: '/platforms/Emu/PS4_logo.png' },
      { id: 'ps5', name: 'PlayStation 5', logo: '/platforms/Emu/PS5_logo.png' },
    ]
  },
  {
    id: 'xbox',
    name: 'Xbox',
    logo: '/platforms/xbox_logo.png',
    color: '#107c10',
    platforms: [
      { id: 'xbox', name: 'Xbox', logo: '/platforms/Emu/Xbox_logo.png' },
      { id: 'xbox360', name: 'Xbox 360', logo: '/platforms/Emu/Xbox360_logo.png' },
      { id: 'xboxone', name: 'Xbox One', logo: '/platforms/Emu/XboxOne_logo.png' },
      { id: 'xboxseriesx', name: 'Xbox Series X/S', logo: '/platforms/Emu/XboxSeriesXS_logo.png' },
    ]
  },
];

// Emulators database from Playnite (92 emulators)
const EMULATORS_DB = {
  gamecube: [
    { name: 'Dolphin', extensions: ['.elf', '.dol', '.gcm', '.tgc', '.ciso', '.gcz', '.iso', '.wad', '.dff', '.rvz', '.m3u'] },
  ],
  ds: [
    { name: 'melonDS', extensions: ['.nds', '.zip'] },
    { name: 'DeSmuME', extensions: ['.nds', '.zip', '.7z', '.rar', '.gz'] },
  ],
  wii: [
    { name: 'Dolphin', extensions: ['.elf', '.dol', '.gcm', '.tgc', '.ciso', '.gcz', '.iso', '.wad', '.dff', '.rvz', '.m3u'] },
  ],
  '3ds': [
    { name: 'Citra', extensions: ['.3ds', '.3dsx', '.cci', '.zcci', '.cxi', '.elf', '.cia'] },
    { name: 'Lime3DS', extensions: ['.3ds', '.3dsx', '.cci', '.cxi', '.elf', '.cia'] },
  ],
  wiiu: [
    { name: 'Cemu', extensions: ['.wud', '.wux', '.rpx', '.wua'] },
  ],
  switch: [
    { name: 'Ryujinx', extensions: ['.nsp', '.xci'] },
    { name: 'Yuzu', extensions: ['.nso', '.nro', '.nca', '.xci', '.nsp'] },
    { name: 'Suyu', extensions: ['.nso', '.nro', '.nca', '.xci', '.nsp'] },
  ],
  ps1: [
    { name: 'DuckStation', extensions: ['.bin', '.img', '.exe', '.chd', '.psexe', '.m3u', '.cue', '.pbp', '.iso'] },
    { name: 'ePSXe', extensions: ['.bin', '.iso', '.img', '.pbp', '.zip', '.cue'] },
    { name: 'PCSXR-PGXP', extensions: ['.bin', '.cue', '.img', '.iso'] },
  ],
  ps2: [
    { name: 'PCSX2', extensions: ['.bin', '.chd', '.cso', '.gz', '.img', '.iso', '.m3u', '.mdf', '.nrg'] },
  ],
  psp: [
    { name: 'PPSSPP', extensions: ['.chd', '.cso', '.iso', '.pbp'] },
  ],
  ps3: [
    { name: 'RPCS3', extensions: ['.bin', '.iso'] },
  ],
  psvita: [
    { name: 'Vita3K', extensions: ['.vpk'] },
  ],
  ps4: [
    { name: 'shadPS4', extensions: ['.bin', '.iso'] },
  ],
  ps5: [
    { name: 'shadPS4', extensions: ['.bin', '.iso'] },
  ],
  xbox: [
    { name: 'Xemu', extensions: ['.iso', '.xiso'] },
  ],
  xbox360: [
    { name: 'Xenia', extensions: ['.iso', '.xex', '.cci', '.cxi', '.elf', '.zar'] },
  ],
  xboxone: [
    { name: 'Xenia Edge', extensions: ['.iso', '.xex'] },
  ],
  xboxseriesx: [
    { name: 'Xenia Edge', extensions: ['.iso', '.xex'] },
  ],
};

// Flat list of all platforms for forms
const ALL_PLATFORMS = COMPANIES.flatMap(c =>
  c.platforms.map(p => ({ ...p, company: c.id, color: c.color }))
);
---

<!-- Tab: Emuladores -->
<div class="settings-panel hidden" id="panel-emulators">
  <div class="settings-section">
    <h3 class="settings-section-title" data-i18n="settings.emulators_title">{t.settings.emulators_title}</h3>

    <!-- Selector de empresas -->
    <div class="companies-selector-section">
      <h4 class="settings-subsection-title" data-i18n="settings.emulators_platforms">{t.settings.emulators_platforms}</h4>

      <div class="companies-selector">
        {COMPANIES.map(company => (
          <div class="company-item">
            <button
              type="button"
              class="company-tab-btn"
              data-company={company.id}
              data-color={company.color}
              style={`--company-color: ${company.color}`}
              title={company.name}
            >
              <img class="company-logo" src={company.logo} alt={company.name} onerror="this.style.display='none'; this.parentElement.classList.add('has-error')" />
              <svg class="company-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                <line x1="9" y1="9" x2="9" y2="9.01"/>
                <line x1="15" y1="9" x2="15" y2="9.01"/>
              </svg>
            </button>
            <span class="company-label">{company.name}</span>
          </div>
        ))}
      </div>

      <!-- Selector de plataformas por empresa -->
      <div class="platforms-selector-container hidden" id="platforms-selector-container">
        <h5 class="platforms-selector-title" id="platforms-selector-title"></h5>
        <div class="platforms-selector" id="platforms-selector"></div>
      </div>

      <!-- Viewport para formularios -->
      <div class="platforms-viewport">
        <div class="platforms-empty-placeholder" id="platforms-empty">
          <span class="platforms-placeholder-icon">🎮</span>
          <h4 data-i18n="settings.platforms_select_title">{t.settings.platforms_select_title}</h4>
          <p data-i18n="settings.platforms_select_hint">{t.settings.platforms_select_hint}</p>
        </div>

        <!-- Forms por plataforma -->
        {ALL_PLATFORMS.map(platform => (
          <div class="platform-form-block hidden" id={`platform-form-${platform.id}`}>
            <div class="platform-form-header">
              <h5 class="platform-form-title" style={`--platform-color: ${platform.color}`}>{platform.name}</h5>
            </div>

            <div class="platform-form-fields">
              <div class="emulator-config-row">
                <div class="emulator-config-left">
                  <label class="form-label" for={`emulator-select-${platform.id}`} data-i18n="settings.emulators_choose">{t.settings.emulators_choose}</label>
                  <select class="form-select emulator-select compact" id={`emulator-select-${platform.id}`} data-platform={platform.id}>
                    <option value="" data-i18n="settings.emulators_no_selection">{t.settings.emulators_no_selection}</option>
                  </select>
                </div>

                <button type="button" class="exe-picker-btn" data-platform={platform.id} title="Select emulator executable">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 19a2 2 0 0 1-2.41 1.97l-5.77-1.72"/>
                    <path d="M2 12a10 10 0 0 1 19.55-3.5"/>
                    <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                  </svg>
                </button>

                <div class="emulator-config-middle" id={`supported-container-${platform.id}`} style="display: none;">
                  <span class="form-label-small">Supported:</span>
                  <div class="supported-types" id={`extensions-display-${platform.id}`}></div>
                </div>

                <div class="emulator-config-right">
                  <label class="form-label" for={`launch-args-${platform.id}`} data-i18n="settings.emulators_args">{t.settings.emulators_args}</label>
                  <input
                    class="form-input"
                    type="text"
                    id={`launch-args-${platform.id}`}
                    placeholder="{ROM}"
                    data-platform={platform.id}
                  />
                </div>

                <button type="button" class="rom-folder-btn" data-platform={platform.id} title="Select ROMs folder">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 19a2 2 0 0 1-2.41 1.97l-5.77-1.72"/>
                    <path d="M2 12a10 10 0 0 1 19.55-3.5"/>
                    <path d="M2 11h20v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/>
                  </svg>
                </button>

                <div class="rom-folder-display" id={`rom-folder-display-${platform.id}`} style="display: none;"></div>

                <input
                  type="hidden"
                  id={`rom-folder-${platform.id}`}
                  data-platform={platform.id}
                />
              </div>

              <div class="form-field">
                <label class="form-label" for={`tracking-mode-${platform.id}`} data-i18n="settings.emulators_tracking">{t.settings.emulators_tracking}</label>
                <select class="form-select" id={`tracking-mode-${platform.id}`} data-platform={platform.id}>
                  <option value="process">Process (Monitor process)</option>
                  <option value="directory">Directory (Monitor folder)</option>
                  <option value="name">Process Name (By name)</option>
                </select>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  // Emulators database
  const emulatorsDB = {
    gamecube: [
      { name: 'Dolphin', extensions: ['.elf', '.dol', '.gcm', '.tgc', '.ciso', '.gcz', '.iso', '.wad', '.dff', '.rvz', '.m3u'] },
    ],
    ds: [
      { name: 'melonDS', extensions: ['.nds', '.zip'] },
      { name: 'DeSmuME', extensions: ['.nds', '.zip', '.7z', '.rar', '.gz'] },
    ],
    wii: [
      { name: 'Dolphin', extensions: ['.elf', '.dol', '.gcm', '.tgc', '.ciso', '.gcz', '.iso', '.wad', '.dff', '.rvz', '.m3u'] },
    ],
    '3ds': [
      { name: 'Citra', extensions: ['.3ds', '.3dsx', '.cci', '.zcci', '.cxi', '.elf', '.cia'] },
      { name: 'Lime3DS', extensions: ['.3ds', '.3dsx', '.cci', '.cxi', '.elf', '.cia'] },
    ],
    wiiu: [
      { name: 'Cemu', extensions: ['.wud', '.wux', '.rpx', '.wua'] },
    ],
    switch: [
      { name: 'Ryujinx', extensions: ['.nsp', '.xci'] },
      { name: 'Yuzu', extensions: ['.nso', '.nro', '.nca', '.xci', '.nsp'] },
      { name: 'Suyu', extensions: ['.nso', '.nro', '.nca', '.xci', '.nsp'] },
    ],
    ps1: [
      { name: 'DuckStation', extensions: ['.bin', '.img', '.exe', '.chd', '.psexe', '.m3u', '.cue', '.pbp', '.iso'] },
      { name: 'ePSXe', extensions: ['.bin', '.iso', '.img', '.pbp', '.zip', '.cue'] },
      { name: 'PCSXR-PGXP', extensions: ['.bin', '.cue', '.img', '.iso'] },
    ],
    ps2: [
      { name: 'PCSX2', extensions: ['.bin', '.chd', '.cso', '.gz', '.img', '.iso', '.m3u', '.mdf', '.nrg'] },
    ],
    psp: [
      { name: 'PPSSPP', extensions: ['.chd', '.cso', '.iso', '.pbp'] },
    ],
    ps3: [
      { name: 'RPCS3', extensions: ['.bin', '.iso'] },
    ],
    psvita: [
      { name: 'Vita3K', extensions: ['.vpk'] },
    ],
    ps4: [
      { name: 'shadPS4', extensions: ['.bin', '.iso'] },
    ],
    ps5: [
      { name: 'shadPS4', extensions: ['.bin', '.iso'] },
    ],
    xbox: [
      { name: 'Xemu', extensions: ['.iso', '.xiso'] },
    ],
    xbox360: [
      { name: 'Xenia', extensions: ['.iso', '.xex', '.cci', '.cxi', '.elf', '.zar'] },
    ],
    xboxone: [
      { name: 'Xenia Edge', extensions: ['.iso', '.xex'] },
    ],
    xboxseriesx: [
      { name: 'Xenia Edge', extensions: ['.iso', '.xex'] },
    ],
  };

  const initEmulatorsTab = () => {
    const companySelectorData = {
      nintendo: {
        name: 'Nintendo',
        color: '#e60012',
        platforms: [
          { id: 'gamecube', name: 'GameCube', logo: '/platforms/Emu/Gamecube_logo.png' },
          { id: 'ds', name: 'Nintendo DS', logo: '/platforms/Emu/NintendoDS_logo.png' },
          { id: 'wii', name: 'Nintendo Wii', logo: '/platforms/Emu/Wii_logo.png' },
          { id: '3ds', name: 'Nintendo 3DS', logo: '/platforms/Emu/3ds_logo.png' },
          { id: 'wiiu', name: 'Wii U', logo: '/platforms/Emu/Wii_U_logo.png' },
          { id: 'switch', name: 'Nintendo Switch', logo: '/platforms/Emu/NSwitch_logo.png' },
        ]
      },
      playstation: {
        name: 'PlayStation',
        color: '#003087',
        platforms: [
          { id: 'ps1', name: 'PlayStation 1', logo: '/platforms/Emu/PS1_logo.png' },
          { id: 'ps2', name: 'PlayStation 2', logo: '/platforms/Emu/PS2_logo.png' },
          { id: 'psp', name: 'PlayStation Portable', logo: '/platforms/Emu/Psp_logo.png' },
          { id: 'ps3', name: 'PlayStation 3', logo: '/platforms/Emu/PS3_logo.png' },
          { id: 'psvita', name: 'PlayStation Vita', logo: '/platforms/Emu/PSVita_logo.png' },
          { id: 'ps4', name: 'PlayStation 4', logo: '/platforms/Emu/PS4_logo.png' },
          { id: 'ps5', name: 'PlayStation 5', logo: '/platforms/Emu/PS5_logo.png' },
        ]
      },
      xbox: {
        name: 'Xbox',
        color: '#107c10',
        platforms: [
          { id: 'xbox', name: 'Xbox', logo: '/platforms/Emu/Xbox_logo.png' },
          { id: 'xbox360', name: 'Xbox 360', logo: '/platforms/Emu/Xbox360_logo.png' },
          { id: 'xboxone', name: 'Xbox One', logo: '/platforms/Emu/XboxOne_logo.png' },
          { id: 'xboxseriesx', name: 'Xbox Series X/S', logo: '/platforms/Emu/XboxSeriesXS_logo.png' },
        ]
      },
    };

    const platformsContainer = document.getElementById('platforms-selector-container');
    const platformsSelector = document.getElementById('platforms-selector');
    const platformsTitle = document.getElementById('platforms-selector-title');
    const platformsEmpty = document.getElementById('platforms-empty');

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.company-tab-btn');
      if (!btn) return;

      const company = btn.dataset.company;
      const data = companySelectorData[company];
      const color = btn.dataset.color;

      const wasActive = btn.classList.contains('active');
      document.querySelectorAll('.company-tab-btn').forEach(b => b.classList.remove('active'));

      if (wasActive) {
        platformsContainer.classList.add('hidden');
        platformsEmpty.style.display = 'flex';
      } else {
        btn.classList.add('active');
        platformsContainer.classList.remove('hidden');
        platformsEmpty.style.display = 'none';

        platformsTitle.textContent = data.name;
        platformsTitle.style.setProperty('--company-color', color);

          platformsSelector.innerHTML = data.platforms.map(platform => `
            <div class="platform-item">
              <button class="platform-selector-btn" data-platform="${platform.id}" style="--platform-color: ${color}" title="${platform.name}">
                <img class="platform-selector-logo" src="${platform.logo}" alt="${platform.name}" onerror="this.style.display='none'; this.parentElement.classList.add('has-error')" />
                <svg class="platform-selector-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                  <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                  <line x1="7" y1="2" x2="17" y2="2"/>
                  <line x1="17" y1="20" x2="7" y2="20"/>
                  <line x1="6" y1="14" x2="18" y2="14"/>
                </svg>
              </button>
            </div>
          `).join('');

          platformsSelector.querySelectorAll('.platform-selector-btn').forEach(pBtn => {
            pBtn.addEventListener('click', () => {
              const platformId = pBtn.dataset.platform;
              document.querySelectorAll('.platform-form-block').forEach(f => f.classList.add('hidden'));
              const formBlock = document.getElementById(`platform-form-${platformId}`);
              if (formBlock) {
                formBlock.classList.remove('hidden');
                // Populate emulator select
                const select = document.getElementById(`emulator-select-${platformId}`);
                const emulators = emulatorsDB[platformId] || [];
                select.innerHTML = '<option value="">None</option>' +
                  emulators.map(e => `<option value="${e.name}">${e.name}</option>`).join('');
              }
            });
          });
      }
    });

    // Handle emulator selection - show extensions
    document.addEventListener('change', (e) => {
      if (e.target.classList.contains('emulator-select')) {
        const platformId = e.target.dataset.platform;
        const selectedEmulator = e.target.value;
        const extensionsDisplay = document.getElementById(`extensions-display-${platformId}`);
        const supportedContainer = document.getElementById(`supported-container-${platformId}`);

        const emulators = emulatorsDB[platformId] || [];
        const emulator = emulators.find(em => em.name === selectedEmulator);

        if (emulator) {
          extensionsDisplay.textContent = emulator.extensions.join(', ');
          supportedContainer.style.display = 'flex';
        } else {
          extensionsDisplay.textContent = '';
          supportedContainer.style.display = 'none';
        }
      }
    });

    // Handle ROM folder selection
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target.closest('.rom-folder-btn')) {
        const btn = target.closest('.rom-folder-btn');
        const platformId = btn.getAttribute('data-platform');
        // TODO: Open file picker for ROM folder
        console.log('ROM folder picker for platform:', platformId);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmulatorsTab);
  } else {
    initEmulatorsTab();
  }

  document.addEventListener('astro:page-load', initEmulatorsTab);
</script>

<style is:global>
  .settings-subsection-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 1rem;
    margin-top: 0;
  }

  /* Empresas selector */
  .companies-selector-section {
    margin-bottom: 2rem;
  }

  .companies-selector {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .company-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .company-tab-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    padding: 0.5rem;
    background: var(--bg-elevated);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--anim-base) var(--anim-ease);
    position: relative;
    overflow: hidden;
  }

  .company-tab-btn:hover {
    border-color: var(--company-color, var(--accent));
    background: var(--bg-primary);
    transform: translateY(-2px);
  }

  .company-tab-btn.active {
    border-color: var(--company-color, var(--accent));
    background: color-mix(in srgb, var(--company-color, var(--accent)) 12%, var(--bg-elevated));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--company-color, var(--accent)) 20%, transparent);
  }

  .company-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    filter: brightness(1) contrast(1.1) saturate(1.1);
  }

  .company-tab-btn:hover .company-logo {
    filter: brightness(1.15) contrast(1.2) saturate(1.2);
  }

  .company-tab-btn.active .company-logo {
    filter: brightness(1.1) contrast(1.25) saturate(1.15);
  }

  @media (prefers-color-scheme: dark) {
    .company-logo {
      filter: brightness(1.05) contrast(1.2) saturate(1.15);
    }

    .company-tab-btn:hover .company-logo {
      filter: brightness(1.2) contrast(1.3) saturate(1.25);
    }

    .company-tab-btn.active .company-logo {
      filter: brightness(1.15) contrast(1.35) saturate(1.2);
    }
  }

  .company-placeholder {
    width: 40%;
    height: 40%;
    color: var(--text-dim);
  }

  .company-tab-btn.has-error .company-placeholder {
    display: block !important;
    color: var(--text-muted);
  }

  .company-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .company-tab-btn.active ~ .company-label {
    color: var(--company-color, var(--accent));
    font-weight: 700;
  }

  /* Selector de plataformas */
  .platforms-selector-container {
    padding: 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  .platforms-selector-container.hidden {
    display: none !important;
  }

  .platforms-selector-title {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--company-color, var(--accent));
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--company-color, var(--accent));
  }

  .platforms-selector {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    justify-items: center;
  }

  .platform-item {
    display: block;
  }

  .platform-selector-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    padding: 0.5rem;
    background: var(--bg-primary);
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
