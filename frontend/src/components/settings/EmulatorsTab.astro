---
import type { Translations } from "../../i18n/index";
import '../../styles/pages/settings-emulators.css';
import { ALL_PLATFORMS, COMPANIES } from '../../lib/settings/emulator-catalog';

interface Props {
  t: Translations;
}
const { t } = Astro.props;

---

<!-- Tab: Emuladores -->
<div class="settings-panel hidden" id="panel-emulators">
  <div class="settings-section">
    <h3 class="settings-section-title" data-i18n="settings.emulators_title">{t.settings.emulators_title}</h3>

    <!-- Selector de empresas -->
    <div class="companies-selector-section">
      <h4 class="settings-subsection-title" data-i18n="settings.emulators_platforms">{t.settings.emulators_platforms}</h4>

      <div class="companies-selector">
        {COMPANIES.map(company => (
          <div class="company-item">
            <button
              type="button"
              class="company-tab-btn"
              data-company={company.id}
              title={company.name}
            >
              <img class="company-logo" src={company.logo} alt={company.name} />
              <svg class="company-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                <line x1="9" y1="9" x2="9" y2="9.01"/>
                <line x1="15" y1="9" x2="15" y2="9.01"/>
              </svg>
            </button>
            <span class="company-label">{company.name}</span>
          </div>
        ))}
      </div>

      <!-- Selector de plataformas por empresa -->
      <div class="platforms-selector-container hidden" id="platforms-selector-container">
        <h5 class="platforms-selector-title" id="platforms-selector-title"></h5>
        <div class="platforms-selector" id="platforms-selector"></div>
      </div>

      <!-- Viewport para formularios -->
      <div class="platforms-viewport">
        <div class="platforms-empty-placeholder" id="platforms-empty">
          <span class="platforms-placeholder-icon">🎮</span>
          <h4 data-i18n="settings.platforms_select_title">{t.settings.platforms_select_title}</h4>
          <p data-i18n="settings.platforms_select_hint">{t.settings.platforms_select_hint}</p>
        </div>

        <!-- Forms por plataforma -->
        {ALL_PLATFORMS.map(platform => (
          <div class="platform-form-block hidden" id={`platform-form-${platform.id}`}>
            <div class="platform-form-header" data-company={platform.company}>
              <h5 class="platform-form-title" data-company={platform.company}>{platform.name}</h5>
            </div>

            <div class="platform-form-fields">
              <div class="emulator-config-row combined-row">
                <div class="emulator-section">
                  <label class="form-label" for={`emulator-select-${platform.id}`} data-i18n="settings.emulators_choose">{t.settings.emulators_choose}</label>
                  <div class="input-row">
                    <select class="form-select emulator-select compact" id={`emulator-select-${platform.id}`} data-platform={platform.id}>
                      <option value="" data-i18n="settings.emulators_no_selection">{t.settings.emulators_no_selection}</option>
                    </select>
                    <button type="button" class="exe-picker-btn" data-platform={platform.id} title="Select emulator executable">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2.41 1.97l-5.77-1.72"/>
                        <path d="M2 12a10 10 0 0 1 19.55-3.5"/>
                        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                      </svg>
                    </button>
                    <div class="emulator-config-middle hidden" id={`supported-container-${platform.id}`}>
                      <span class="form-label-small">Supported:</span>
                      <div class="supported-types" id={`extensions-display-${platform.id}`}></div>
                    </div>
                  </div>
                </div>

                <div class="launch-section">
                  <label class="form-label" for={`launch-args-${platform.id}`} data-i18n="settings.emulators_args">{t.settings.emulators_args}</label>
                  <div class="input-row">
                    <input
                      class="form-input"
                      type="text"
                      id={`launch-args-${platform.id}`}
                      placeholder="{ROM}"
                      data-platform={platform.id}
                    />
                    <button type="button" class="rom-folder-btn" data-platform={platform.id} title="Select ROMs folder">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2.41 1.97l-5.77-1.72"/>
                        <path d="M2 12a10 10 0 0 1 19.55-3.5"/>
                        <path d="M2 11h20v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/>
                      </svg>
                    </button>
                    <div class="rom-folder-display" id={`rom-folder-display-${platform.id}`}></div>
                    <input
                      type="hidden"
                      id={`rom-folder-${platform.id}`}
                      data-platform={platform.id}
                    />
                  </div>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import { COMPANIES, EMULATORS_DB } from '../../lib/settings/emulator-catalog';

  // Only the document-level listener REGISTRATION below needs to happen
  // once — the listeners themselves stay attached across Astro's
  // client-side navigation (astro:page-load fires again without a real
  // page reload, and this script's own top-level state — this flag
  // included — survives that, unlike a hard refresh). Re-fetching
  // emulatorsData every time this runs is cheap and keeps it from showing
  // whatever was saved on a PREVIOUS visit instead of what's actually in
  // the database now.
  let listenersAttached = false;
  let emulatorsData: Record<string, any> = {};
  let emulatorSelections: Record<string, string> = {};
  let emulatorsDataReady: Promise<void> = Promise.resolve();

  const initEmulatorsTab = async () => {
    // Refresh on each Astro navigation. Existing delegated listeners survive
    // navigation, so platform clicks must wait for this visit's database read
    // instead of using the previous visit's (possibly empty) snapshot.
    emulatorsDataReady = (async () => {
      try {
        const { readEmulatorsConfig } = await import('../../lib/tauri');
        emulatorsData = await readEmulatorsConfig();
        emulatorSelections = Object.fromEntries(
          Object.entries(emulatorsData).map(([platformId, config]) => [platformId, config?.emulator_name || ''])
        );
        console.log('[Init] Loaded emulators data:', emulatorsData);
      } catch (error) {
        console.error('[Init] Failed to load emulators data:', error);
        emulatorsData = {};
        emulatorSelections = {};
      }
    })();
    await emulatorsDataReady;

    if (listenersAttached) return;
    listenersAttached = true;

    document.addEventListener('error', (event) => {
      const image = event.target;
      if (!(image instanceof HTMLImageElement)) return;
      if (image.matches('.company-logo, .platform-selector-logo')) {
        image.parentElement?.classList.add('has-error');
      }
    }, true);

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.company-tab-btn');
      if (!btn) return;

      // Looked up fresh on every click, not once when this listener was
      // first attached — this listener itself only ever gets attached once
      // (see listenersAttached above) and correctly stays working across
      // Astro's client-side navigation, but the markup it targets gets
      // re-rendered every time this settings tab is revisited. Closing
      // over the FIRST visit's nodes meant every visit after that quietly
      // updated detached elements nobody could see — the click registered
      // (this handler ran), but nothing changed on screen — until an F5
      // forced the whole script to re-evaluate from scratch.
      const platformsContainer = document.getElementById('platforms-selector-container');
      const platformsSelector = document.getElementById('platforms-selector');
      const platformsTitle = document.getElementById('platforms-selector-title');
      const platformsEmpty = document.getElementById('platforms-empty');
      if (!platformsContainer || !platformsSelector || !platformsTitle || !platformsEmpty) return;

      const company = btn.dataset.company;
      const data = COMPANIES.find(item => item.id === company);
      if (!data) return;
      const wasActive = btn.classList.contains('active');
      document.querySelectorAll('.company-tab-btn').forEach(b => b.classList.remove('active'));

      if (wasActive) {
        platformsContainer.classList.add('hidden');
        platformsEmpty.classList.remove('hidden');
      } else {
        btn.classList.add('active');
        platformsContainer.classList.remove('hidden');
        platformsEmpty.classList.add('hidden');

        platformsTitle.textContent = data.name;
        platformsTitle.dataset.company = company;

          platformsSelector.innerHTML = data.platforms.map(platform => `
            <div class="platform-item">
              <button class="platform-selector-btn" data-platform="${platform.id}" data-company="${company}" title="${platform.name}">
                <img class="platform-selector-logo" src="${platform.logo}" alt="${platform.name}" />
                <svg class="platform-selector-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                  <line x1="7" y1="2" x2="17" y2="2"/>
                  <line x1="17" y1="20" x2="7" y2="20"/>
                  <line x1="6" y1="14" x2="18" y2="14"/>
                </svg>
              </button>
            </div>
          `).join('');

          platformsSelector.querySelectorAll('.platform-selector-btn').forEach(pBtn => {
            pBtn.addEventListener('click', async () => {
              await emulatorsDataReady;
              const platformId = pBtn.dataset.platform;
              document.querySelectorAll('.platform-form-block').forEach(f => f.classList.add('hidden'));
              const formBlock = document.getElementById(`platform-form-${platformId}`);
              if (formBlock) {
                formBlock.classList.remove('hidden');
                // Populate emulator select
                const select = document.getElementById(`emulator-select-${platformId}`);
                const emulators = EMULATORS_DB[platformId] || [];
                select.innerHTML = '<option value="">None</option>' +
                  emulators.map(e => `<option value="${e.name}">${e.name}</option>`).join('');
                // Load saved emulator value from database
                const savedValue = emulatorSelections[platformId] ?? emulatorsData[platformId]?.emulator_name ?? '';
                if (savedValue) {
                  select.value = savedValue;
                  updateSupportedDisplay(platformId, savedValue);
                } else {
                  updateSupportedDisplay(platformId, '');
                }
              }
            });
          });
      }
    });

    // Function to update supported extensions display
    const updateSupportedDisplay = (platformId, selectedEmulator) => {
      const extensionsDisplay = document.getElementById(`extensions-display-${platformId}`);
      const supportedContainer = document.getElementById(`supported-container-${platformId}`);
      const emulators = EMULATORS_DB[platformId] || [];
      const emulator = emulators.find(em => em.name === selectedEmulator);

      if (emulator && selectedEmulator) {
        extensionsDisplay.textContent = emulator.extensions.join(', ');
        supportedContainer.classList.remove('hidden');
      } else {
        extensionsDisplay.textContent = '';
        supportedContainer.classList.add('hidden');
      }
    };

    // Handle emulator selection - show extensions
    document.addEventListener('change', (e) => {
      const select = e.target;
      if (!(select instanceof HTMLSelectElement) || !select.classList.contains('emulator-select')) return;
      const platformId = select.dataset.platform;
      if (!platformId) return;
      emulatorSelections[platformId] = select.value;
      updateSupportedDisplay(platformId, select.value);
    });

    window.addEventListener('emulators-config-reset', (event) => {
      const configs = (event as CustomEvent<Record<string, any>>).detail;
      emulatorsData = configs || {};
      emulatorSelections = Object.fromEntries(
        Object.entries(emulatorsData).map(([platformId, config]) => [platformId, config?.emulator_name || ''])
      );
      document.querySelectorAll<HTMLSelectElement>('.emulator-select').forEach((select) => {
        const platformId = select.dataset.platform;
        if (!platformId || select.options.length <= 1) return;
        const value = emulatorSelections[platformId] || '';
        select.value = value;
        updateSupportedDisplay(platformId, value);
      });
    });

    // Handle ROM folder selection
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target.closest('.rom-folder-btn')) {
        const btn = target.closest('.rom-folder-btn');
        const platformId = btn.getAttribute('data-platform');
        // TODO: Open file picker for ROM folder
        console.log('ROM folder picker for platform:', platformId);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmulatorsTab);
  } else {
    initEmulatorsTab();
  }

  document.addEventListener('astro:page-load', initEmulatorsTab);
</script>
