---
import type { Translations } from "../../i18n/index";
import '../../styles/pages/settings-emulators.css';
import { ALL_PLATFORMS, COMPANIES } from '../../lib/local/emulator-catalog';

interface Props {
  t: Translations;
}
const { t } = Astro.props;

---

<!-- Tab: Emuladores. Top row: platform linking (the main job of the tab, with
     the chosen console's editor under its tiles) | Library (ROM clean-up) |
     Saved games. The play-session reminders live in
     AccessibilityTab. -->
<div class="settings-panel hidden" id="panel-emulators">
  <div class="settings-section emu-section">
    <div class="emu-top-row">
      <!-- Selector de empresas -->
      <div class="emu-top-col companies-selector-section">
        <h3 class="settings-section-title" data-i18n="settings.emulators_platforms">{t.settings.emulators_platforms}</h3>

        <div class="companies-selector">
          {COMPANIES.map(company => (
            <div class="company-item">
              <button
                type="button"
                class="company-tab-btn"
                data-company={company.id}
                title={company.name}
              >
                <img class="company-logo" src={company.logo} alt={company.name} />
                <svg class="company-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                  <line x1="9" y1="9" x2="9" y2="9.01"/>
                  <line x1="15" y1="9" x2="15" y2="9.01"/>
                </svg>
              </button>
              <span class="company-label">{company.name}</span>
            </div>
          ))}
        </div>

        <!-- Selector de plataformas por empresa -->
        <div class="platforms-selector-container hidden" id="platforms-selector-container">
          <h5 class="platforms-selector-title" id="platforms-selector-title"></h5>
          <div class="platforms-selector" id="platforms-selector"></div>
        </div>

        <!-- Viewport para formularios: the chosen console's editor, in this
             column under the console tiles, groups stacked. -->
        <div class="platforms-viewport">
          <p class="platforms-empty-placeholder" id="platforms-empty">
            <span class="platforms-empty-title" data-i18n="settings.platforms_select_title">{t.settings.platforms_select_title}</span>
            <span class="platforms-empty-hint" data-i18n="settings.platforms_select_hint">{t.settings.platforms_select_hint}</span>
          </p>

          <!-- Forms por plataforma -->
          {ALL_PLATFORMS.map(platform => (
            <div class="platform-form-block hidden" id={`platform-form-${platform.id}`}>
              <div class="platform-form-header" data-company={platform.company}>
                <h5 class="platform-form-title" data-company={platform.company}>{platform.name}</h5>
              </div>

              <!-- Stacked, compact groups: Emulator (+ captures-folder
                   disclosure; its "Compatible" list is what the ROM scan uses) |
                   Launch arguments. -->
              <div class="platform-form-fields emu-editor-row">
                <div class="emu-editor-field emulator-section">
                  <label class="form-label" for={`emulator-select-${platform.id}`} data-i18n="settings.emulators_choose">{t.settings.emulators_choose}</label>
                  <div class="input-row">
                    <select class="form-select emulator-select compact" id={`emulator-select-${platform.id}`} data-platform={platform.id}>
                      <option value="" data-i18n="settings.emulators_no_selection">{t.settings.emulators_no_selection}</option>
                    </select>
                    <button type="button" class="exe-picker-btn" data-platform={platform.id} title={t.settings.emulators_pick_executable} data-i18n-title="settings.emulators_pick_executable">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2.41 1.97l-5.77-1.72"/>
                        <path d="M2 12a10 10 0 0 1 19.55-3.5"/>
                        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                      </svg>
                    </button>
                    <!-- Advanced: the folder the emulator itself saves captures to, only
                         for emulators the auto-detection table does not know. It is a
                         SOURCE: captures are always moved to Pictures/Metadea/<game>/.
                         A small camera disclosure next to the folder button; opens as a popover. -->
                    <details class="emulator-screenshots-override">
                      <summary title={t.local.emulator_screenshots_dir} data-i18n-title="local.emulator_screenshots_dir" aria-label={t.local.emulator_screenshots_dir} data-i18n-aria-label="local.emulator_screenshots_dir">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/>
                          <circle cx="12" cy="13" r="3"/>
                        </svg>
                      </summary>
                      <div class="emulator-screenshots-popover">
                        <div class="emu-editor-label">
                          <span class="form-label" data-i18n="local.emulator_screenshots_dir">{t.local.emulator_screenshots_dir}</span>
                          <span class="settings-help-btn" tabindex="0" role="img" title={t.local.emulator_screenshots_dir_hint} data-i18n-title="local.emulator_screenshots_dir_hint" aria-label={t.local.emulator_screenshots_dir_hint} data-i18n-aria-label="local.emulator_screenshots_dir_hint">
                            <span class="info-indicator" aria-hidden="true">i</span>
                          </span>
                        </div>
                        <div class="input-row">
                          <input
                            class="form-input"
                            type="text"
                            id={`screenshots-dir-${platform.id}`}
                            data-platform={platform.id}
                            spellcheck="false"
                            aria-label={t.local.emulator_screenshots_dir}
                            data-i18n-aria-label="local.emulator_screenshots_dir"
                          />
                          <button type="button" class="rom-folder-btn" data-platform={platform.id} data-field="screenshots-dir" title={t.local.emulator_screenshots_pick} data-i18n-title="local.emulator_screenshots_pick">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M2 11h20v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/>
                              <rect x="6" y="4" width="12" height="7" rx="1"/>
                              <circle cx="12" cy="7.5" r="1.5"/>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </details>
                    <div class="emulator-config-middle hidden" id={`supported-container-${platform.id}`}>
                      <span class="emu-compat-icon" role="img" title={t.settings.emulators_supported_title} data-i18n-title="settings.emulators_supported_title" aria-label={t.settings.emulators_supported_title} data-i18n-aria-label="settings.emulators_supported_title">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
                        </svg>
                      </span>
                      <div class="supported-types" id={`extensions-display-${platform.id}`}></div>
                    </div>
                  </div>
                </div>

                <div class="emu-editor-field launch-section">
                  <label class="form-label" for={`launch-args-${platform.id}`} data-i18n="settings.emulators_args">{t.settings.emulators_args}</label>
                  <div class="input-row">
                    <input
                      class="form-input emu-editor-args"
                      type="text"
                      id={`launch-args-${platform.id}`}
                      placeholder="{ROM}"
                      data-platform={platform.id}
                    />
                    <button type="button" class="rom-folder-btn" data-platform={platform.id} title={t.settings.emulators_pick_rom_folder} data-i18n-title="settings.emulators_pick_rom_folder">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2.41 1.97l-5.77-1.72"/>
                        <path d="M2 12a10 10 0 0 1 19.55-3.5"/>
                        <path d="M2 11h20v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/>
                      </svg>
                    </button>
                    <div class="rom-folder-display" id={`rom-folder-display-${platform.id}`}></div>
                    <input
                      type="hidden"
                      id={`rom-folder-${platform.id}`}
                      data-platform={platform.id}
                    />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Library: automatic ROM file clean-up (local.roms.auto_rename). -->
      <div class="emu-top-col emu-library">
        <h3 class="settings-section-title" data-i18n="settings.library_section_title">{t.settings.library_section_title}</h3>
        <div class="emu-inline-row">
          <label class="settings-checkbox-label">
            <input type="checkbox" id="roms-auto-rename" class="settings-checkbox" />
            <span class="checkbox-label-text" data-i18n="settings.roms_auto_rename">{t.settings.roms_auto_rename}</span>
          </label>
          <span class="settings-help-btn" tabindex="0" role="img" title={t.settings.roms_auto_rename_hint} data-i18n-title="settings.roms_auto_rename_hint" aria-label={t.settings.roms_auto_rename_hint} data-i18n-aria-label="settings.roms_auto_rename_hint">
            <span class="info-indicator" aria-hidden="true">i</span>
          </span>
        </div>
      </div>

      <!-- Saved games: one central folder (src-tauri/src/saves; behaviour in
           mount/saves-settings.ts, docs/SAVES.md). -->
      <div class="emu-top-col saves-settings" id="saves-settings">
        <!-- Same title element as Library; the text and its (i) form one item,
             so themes that flank titles with lines keep them centred. -->
        <h3 class="settings-section-title">
          <span class="emu-title-with-info">
            <span data-i18n="saves.settings_title">{t.saves.settings_title}</span>
            <span class="settings-help-btn" tabindex="0" role="img" title={t.saves.settings_intro} data-i18n-title="saves.settings_intro" aria-label={t.saves.settings_intro} data-i18n-aria-label="saves.settings_intro">
              <span class="info-indicator" aria-hidden="true">i</span>
            </span>
          </span>
        </h3>
        <div class="emu-inline-row saves-settings-root">
          <span class="form-label" data-i18n="saves.root_label">{t.saves.root_label}</span>
          <span class="settings-help-btn" tabindex="0" role="img" title={t.saves.root_info} data-i18n-title="saves.root_info" aria-label={t.saves.root_info} data-i18n-aria-label="saves.root_info">
            <span class="info-indicator" aria-hidden="true">i</span>
          </span>
          <!-- rtl + an ltr <bdi>: the ellipsis eats the START of a long path so the
               folder name stays visible; the full path is the field's tooltip. -->
          <span class="saves-settings-path"><bdi dir="ltr" id="saves-root-path"></bdi></span>
          <button type="button" class="emu-icon-btn" id="saves-root-change" title={t.saves.root_change} data-i18n-title="saves.root_change" aria-label={t.saves.root_change} data-i18n-aria-label="saves.root_change">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
            </svg>
          </button>
          <button type="button" class="emu-icon-btn" id="saves-root-reset" hidden title={t.saves.root_reset} data-i18n-title="saves.root_reset" aria-label={t.saves.root_reset} data-i18n-aria-label="saves.root_reset">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>
            </svg>
          </button>
          <button type="button" class="emu-icon-btn" id="saves-root-open" title={t.saves.root_open} data-i18n-title="saves.root_open" aria-label={t.saves.root_open} data-i18n-aria-label="saves.root_open">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><path d="M12 11v6"/><path d="m9 14 3-3 3 3"/>
            </svg>
          </button>
        </div>

        <div class="emu-inline-row saves-settings-import">
          <label class="form-label" for="saves-history-keep" data-i18n="saves.history_label">{t.saves.history_label}</label>
          <span class="settings-help-btn" tabindex="0" role="img" title={t.saves.history_info} data-i18n-title="saves.history_info" aria-label={t.saves.history_info} data-i18n-aria-label="saves.history_info">
            <span class="info-indicator" aria-hidden="true">i</span>
          </span>
          <input class="form-input saves-settings-keep" type="number" id="saves-history-keep" min="1" max="50" step="1" inputmode="numeric" />
          <span class="emu-inline-sep" aria-hidden="true"></span>
          <button type="button" class="btn btn--sm btn--secondary" id="saves-import-btn" data-i18n="saves.import_button">{t.saves.import_button}</button>
          <span class="settings-help-btn" tabindex="0" role="img" title={t.saves.import_info} data-i18n-title="saves.import_info" aria-label={t.saves.import_info} data-i18n-aria-label="saves.import_info">
            <span class="info-indicator" aria-hidden="true">i</span>
          </span>
          <span class="settings-hint saves-settings-status" id="saves-import-status" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { COMPANIES, EMULATORS_DB } from '../../lib/local/emulator-catalog';
  import type { EmulatorConfig } from '../../lib/tauri/emulators';

  // Only the document-level listener REGISTRATION below needs to happen
  // once — the listeners themselves stay attached across Astro's
  // client-side navigation (astro:page-load fires again without a real
  // page reload, and this script's own top-level state — this flag
  // included — survives that, unlike a hard refresh). Re-fetching
  // emulatorsData every time this runs is cheap and keeps it from showing
  // whatever was saved on a PREVIOUS visit instead of what's actually in
  // the database now.
  let listenersAttached = false;
  let emulatorsData: Record<string, EmulatorConfig> = {};
  let emulatorSelections: Record<string, string> = {};
  let emulatorsDataReady: Promise<void> = Promise.resolve();

  const selectionsFrom = (configs: Record<string, EmulatorConfig>) => Object.fromEntries(
    Object.entries(configs).map(([platformId, config]) => [platformId, config?.emulator_name || ''])
  );

  const initEmulatorsTab = async () => {
    // Refresh on each Astro navigation. Existing delegated listeners survive
    // navigation, so platform clicks must wait for this visit's database read
    // instead of using the previous visit's (possibly empty) snapshot.
    emulatorsDataReady = (async () => {
      try {
        const { readEmulatorsConfig } = await import('../../lib/tauri');
        emulatorsData = await readEmulatorsConfig();
        emulatorSelections = selectionsFrom(emulatorsData);
      } catch (error) {
        console.error('[Init] Failed to load emulators data:', error);
        emulatorsData = {};
        emulatorSelections = {};
      }
    })();
    await emulatorsDataReady;

    if (listenersAttached) return;
    listenersAttached = true;

    document.addEventListener('error', (event) => {
      const image = event.target;
      if (!(image instanceof HTMLImageElement)) return;
      if (image.matches('.company-logo, .platform-selector-logo')) {
        image.parentElement?.classList.add('has-error');
      }
    }, true);

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.company-tab-btn');
      if (!btn) return;

      // Looked up fresh on every click, not once when this listener was
      // first attached — this listener itself only ever gets attached once
      // (see listenersAttached above) and correctly stays working across
      // Astro's client-side navigation, but the markup it targets gets
      // re-rendered every time this settings tab is revisited. Closing
      // over the FIRST visit's nodes meant every visit after that quietly
      // updated detached elements nobody could see — the click registered
      // (this handler ran), but nothing changed on screen — until an F5
      // forced the whole script to re-evaluate from scratch.
      const platformsContainer = document.getElementById('platforms-selector-container');
      const platformsSelector = document.getElementById('platforms-selector');
      const platformsTitle = document.getElementById('platforms-selector-title');
      const platformsEmpty = document.getElementById('platforms-empty');
      if (!platformsContainer || !platformsSelector || !platformsTitle || !platformsEmpty) return;

      const company = btn.dataset.company;
      const data = COMPANIES.find(item => item.id === company);
      if (!data) return;
      const wasActive = btn.classList.contains('active');
      document.querySelectorAll('.company-tab-btn').forEach(b => b.classList.remove('active'));
      // A brand change (or closing the brand) closes the open console editor:
      // the new brand shows its tiles with nothing open until one is picked.
      document.querySelectorAll('.platform-form-block').forEach(f => f.classList.add('hidden'));

      if (wasActive) {
        platformsContainer.classList.add('hidden');
        platformsEmpty.classList.remove('hidden');
      } else {
        btn.classList.add('active');
        platformsContainer.classList.remove('hidden');
        platformsEmpty.classList.add('hidden');

        platformsTitle.textContent = data.name;
        platformsTitle.dataset.company = company;

          platformsSelector.innerHTML = data.platforms.map(platform => `
            <div class="platform-item">
              <button class="platform-selector-btn" data-platform="${platform.id}" data-company="${company}" title="${platform.name}">
                <img class="platform-selector-logo" src="${platform.logo}" alt="${platform.name}" />
                <svg class="platform-selector-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                  <line x1="7" y1="2" x2="17" y2="2"/>
                  <line x1="17" y1="20" x2="7" y2="20"/>
                  <line x1="6" y1="14" x2="18" y2="14"/>
                </svg>
              </button>
            </div>
          `).join('');

          platformsSelector.querySelectorAll('.platform-selector-btn').forEach(pBtn => {
            pBtn.addEventListener('click', async () => {
              await emulatorsDataReady;
              const platformId = pBtn.dataset.platform;
              const formBlock = document.getElementById(`platform-form-${platformId}`);
              // Clicking the console whose editor is open closes it; another
              // console switches the editor to that one.
              const wasOpen = !!formBlock && !formBlock.classList.contains('hidden');
              document.querySelectorAll('.platform-form-block').forEach(f => f.classList.add('hidden'));
              platformsSelector.querySelectorAll('.platform-selector-btn').forEach(b => b.classList.remove('active'));
              if (wasOpen) return;
              pBtn.classList.add('active');
              if (formBlock) {
                formBlock.classList.remove('hidden');
                // Populate emulator select
                const select = document.getElementById(`emulator-select-${platformId}`);
                const emulators = EMULATORS_DB[platformId] || [];
                select.innerHTML = '<option value="">None</option>' +
                  emulators.map(e => `<option value="${e.name}">${e.name}</option>`).join('');
                // Load saved emulator value from database
                const savedValue = emulatorSelections[platformId] ?? emulatorsData[platformId]?.emulator_name ?? '';
                if (savedValue) {
                  select.value = savedValue;
                  updateSupportedDisplay(platformId, savedValue);
                } else {
                  updateSupportedDisplay(platformId, '');
                }
              }
            });
          });
      }
    });

    // Function to update supported extensions display
    const updateSupportedDisplay = (platformId, selectedEmulator) => {
      const extensionsDisplay = document.getElementById(`extensions-display-${platformId}`);
      const supportedContainer = document.getElementById(`supported-container-${platformId}`);
      const emulators = EMULATORS_DB[platformId] || [];
      const emulator = emulators.find(em => em.name === selectedEmulator);

      if (emulator && selectedEmulator) {
        // "3ds · 3dsx · cci": no dots, so more of the list fits the row.
        extensionsDisplay.textContent = emulator.extensions.map(ext => ext.replace(/^\./, '')).join(' · ');
        extensionsDisplay.title = extensionsDisplay.textContent;
        supportedContainer.classList.remove('hidden');
      } else {
        extensionsDisplay.textContent = '';
        supportedContainer.classList.add('hidden');
      }
    };

    // Handle emulator selection - show extensions
    document.addEventListener('change', (e) => {
      const select = e.target;
      if (!(select instanceof HTMLSelectElement) || !select.classList.contains('emulator-select')) return;
      const platformId = select.dataset.platform;
      if (!platformId) return;
      emulatorSelections[platformId] = select.value;
      updateSupportedDisplay(platformId, select.value);
    });

    window.addEventListener('emulators-config-reset', (event) => {
      const configs = (event as CustomEvent<Record<string, EmulatorConfig>>).detail;
      emulatorsData = configs || {};
      emulatorSelections = selectionsFrom(emulatorsData);
      document.querySelectorAll<HTMLSelectElement>('.emulator-select').forEach((select) => {
        const platformId = select.dataset.platform;
        if (!platformId || select.options.length <= 1) return;
        const value = emulatorSelections[platformId] || '';
        select.value = value;
        updateSupportedDisplay(platformId, value);
      });
    });

  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmulatorsTab);
  } else {
    initEmulatorsTab();
  }

  document.addEventListener('astro:page-load', initEmulatorsTab);
</script>
