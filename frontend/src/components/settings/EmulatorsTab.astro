---
import type { Translations } from "../../i18n/index";

interface Props {
  t: Translations;
}
const { t } = Astro.props;

const PLATFORMS = [
  { id: 'gamecube', name: 'GameCube', logo: '/platforms/Emu/GameCube_logo.png' },
  { id: 'ds', name: 'Nintendo DS', logo: '/platforms/Emu/DS_logo.png' },
  { id: 'wii', name: 'Nintendo Wii', logo: '/platforms/Emu/Wii_logo.png' },
  { id: '3ds', name: 'Nintendo 3DS', logo: '/platforms/Emu/3DS_logo.png' },
  { id: 'wiiu', name: 'Wii U', logo: '/platforms/Emu/WiiU_logo.png' },
  { id: 'switch', name: 'Nintendo Switch', logo: '/platforms/Emu/Switch_logo.png' },
  { id: 'ps1', name: 'PlayStation 1', logo: '/platforms/Emu/PS1_logo.png' },
  { id: 'ps2', name: 'PlayStation 2', logo: '/platforms/Emu/PS2_logo.png' },
  { id: 'ps3', name: 'PlayStation 3', logo: '/platforms/Emu/PS3_logo.png' },
  { id: 'ps4', name: 'PlayStation 4', logo: '/platforms/Emu/PS4_logo.png' },
  { id: 'ps5', name: 'PlayStation 5', logo: '/platforms/Emu/PS5_logo.png' },
];
---

<!-- Tab: Emuladores -->
<div class="settings-panel hidden" id="panel-emulators">
  <div class="settings-section">
    <h3 class="settings-section-title" data-i18n="settings.emulators_title">{t.settings.emulators_title}</h3>

    <!-- Agregar nuevo emulador -->
    <div class="emulators-add-section">
      <h4 class="settings-subsection-title" data-i18n="settings.emulators_add_new">{t.settings.emulators_add_new}</h4>

      <div class="emulators-form">
        <div class="emulator-field">
          <label class="emulator-label" for="emulator-name" data-i18n="settings.emulators_name">{t.settings.emulators_name}</label>
          <input
            class="emulator-input"
            type="text"
            id="emulator-name"
            placeholder="RetroArch, PCSX2, Dolphin..."
            autocomplete="off"
          />
        </div>

        <div class="emulator-field">
          <label class="emulator-label" for="emulator-path" data-i18n="settings.emulators_path">{t.settings.emulators_path}</label>
          <div class="emulator-path-group">
            <input
              class="emulator-input"
              type="text"
              id="emulator-path"
              placeholder="C:\Program Files\emulator.exe"
              readonly
            />
            <button type="button" class="emulator-browse-btn" id="emulator-browse-btn" data-i18n="settings.emulators_browse">{t.settings.emulators_browse}</button>
          </div>
        </div>

        <div class="emulator-field">
          <label class="emulator-label" for="emulator-args" data-i18n="settings.emulators_args">{t.settings.emulators_args}</label>
          <input
            class="emulator-input"
            type="text"
            id="emulator-args"
            placeholder="%ROM% (opcional)"
            autocomplete="off"
          />
        </div>

        <button type="button" class="emulator-add-btn" id="emulator-add-btn" data-i18n="settings.emulators_add_btn">{t.settings.emulators_add_btn}</button>
      </div>
    </div>

    <!-- Selector de plataformas (como API keys) -->
    <div class="platforms-selector-section">
      <h4 class="settings-subsection-title" data-i18n="settings.emulators_platforms">{t.settings.emulators_platforms}</h4>

      <div class="platforms-selector">
        {PLATFORMS.map(platform => (
          <div class="platform-item">
            <button
              type="button"
              class="platform-tab-btn"
              data-platform={platform.id}
              data-i18n-title={`settings.platform_${platform.id}`}
              title={platform.name}
            >
              <img class="platform-logo" src={platform.logo} alt={platform.name} />
            </button>
            <span class="platform-label">{platform.name}</span>
          </div>
        ))}
      </div>

      <!-- Viewport para formularios -->
      <div class="platforms-viewport">
        <div class="platforms-empty-placeholder" id="platforms-empty">
          <span class="platforms-placeholder-icon">🎮</span>
          <h4 data-i18n="settings.platforms_select_title">{t.settings.platforms_select_title}</h4>
          <p data-i18n="settings.platforms_select_hint">{t.settings.platforms_select_hint}</p>
        </div>

        <!-- Forms por plataforma -->
        {PLATFORMS.map(platform => (
          <div class="platform-form-block hidden" id={`platform-form-${platform.id}`}>
            <div class="platform-form-header">
              <h5 class="platform-form-title">{platform.name}</h5>
            </div>

            <div class="platform-form-fields">
              <div class="form-field">
                <label class="form-label" for={`emulator-select-${platform.id}`} data-i18n="settings.emulators_choose">{t.settings.emulators_choose}</label>
                <select class="form-select emulator-select" id={`emulator-select-${platform.id}`} data-platform={platform.id}>
                  <option value="" data-i18n="settings.emulators_no_selection">{t.settings.emulators_no_selection}</option>
                </select>
              </div>

              <div class="form-field">
                <label class="form-label" for={`rom-folder-${platform.id}`} data-i18n="settings.emulators_rom_folder">{t.settings.emulators_rom_folder}</label>
                <div class="folder-input-group">
                  <input
                    class="form-input"
                    type="text"
                    id={`rom-folder-${platform.id}`}
                    placeholder={`C:\\Roms\\${platform.name}`}
                    readonly
                    data-platform={platform.id}
                  />
                  <button type="button" class="folder-browse-btn" data-platform={platform.id} data-i18n="settings.emulators_browse">{t.settings.emulators_browse}</button>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
  .emulators-add-section {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .settings-subsection-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 1rem;
    margin-top: 0;
  }

  .emulators-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .emulator-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .emulator-label,
  .form-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-main);
  }

  .emulator-input,
  .form-input,
  .form-select {
    padding: 0.6rem 0.875rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    font-size: 0.85rem;
    font-family: inherit;
    transition: border-color var(--anim-base) var(--anim-ease);
  }

  .emulator-input:focus,
  .form-input:focus,
  .form-select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .emulator-path-group,
  .folder-input-group {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .emulator-path-group .emulator-input,
  .folder-input-group .form-input {
    flex: 1;
    min-width: 0;
  }

  .emulator-browse-btn,
  .folder-browse-btn {
    padding: 0.6rem 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--anim-base) var(--anim-ease);
    white-space: nowrap;
  }

  .emulator-browse-btn:hover,
  .folder-browse-btn:hover {
    background: var(--bg-elevated);
    border-color: var(--accent);
    color: var(--accent);
  }

  .emulator-add-btn {
    align-self: flex-start;
    padding: 0.6rem 1.25rem;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    color: var(--bg-primary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--anim-base) var(--anim-ease);
  }

  .emulator-add-btn:hover {
    opacity: 0.9;
  }

  .emulator-add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Plataformas selector (como API keys) */
  .platforms-selector-section {
    margin-bottom: 2rem;
  }

  .platforms-selector {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .platform-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .platform-tab-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    padding: 0.75rem;
    background: var(--bg-elevated);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--anim-base) var(--anim-ease);
  }

  .platform-tab-btn:hover {
    border-color: var(--accent);
    background: var(--bg-primary);
    transform: translateY(-2px);
  }

  .platform-tab-btn.active {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-elevated));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .platform-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0.9);
  }

  .platform-tab-btn:hover .platform-logo,
  .platform-tab-btn.active .platform-logo {
    filter: brightness(1) opacity(1);
  }

  .platform-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .platform-tab-btn.active ~ .platform-label {
    color: var(--accent);
  }

  /* Viewport para formularios */
  .platforms-viewport {
    padding: 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    min-height: 200px;
  }

  .platforms-empty-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
  }

  .platforms-empty-placeholder h4 {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .platforms-empty-placeholder p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .platforms-placeholder-icon {
    font-size: 2rem;
  }

  .platform-form-block {
    display: block;
  }

  .platform-form-block.hidden {
    display: none !important;
  }

  .platform-form-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .platform-form-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
  }

  .platform-form-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hidden {
    display: none !important;
  }
</style>
