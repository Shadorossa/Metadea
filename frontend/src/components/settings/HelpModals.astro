---
// Every "¿Qué es X?" / "¿Cómo obtener la clave de X?" popup in Settings,
// in one shared place instead of split across ConnectionsTab.astro and
// EnvironmentTab.astro. That split used to cause two real bugs:
//   1. Both tabs had their own <div id="anilist-help-modal">, a duplicate
//      DOM id — document.getElementById always resolves to whichever one
//      rendered first (EnvironmentTab's, since it's imported before
//      ConnectionsTab in settings.astro), so Conexiones' AniList "i" button
//      always opened *Environment*'s modal instead of its own.
//   2. Every modal lived nested inside its own tab's .settings-panel, which
//      gets display:none whenever that tab isn't the active one — so
//      opening a help modal while on a *different* tab (exactly what the
//      duplicate-id bug above forced) rendered it invisible, hidden along
//      with the whole panel it happened to be sitting in.
// Rendered once in settings.astro, as a sibling of .settings-content (not
// nested inside any single .settings-panel), so every help button works
// identically regardless of which tab is currently active — see
// setupHelpModals() in settings.astro, which is itself already generic
// (data-help="x" opens #x-help-modal) and needed no changes for this.

import type { Translations } from '../../i18n/index';
import { MAL_REDIRECT_URI } from '../../lib/tauri/mal';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<!-- GitHub -->
<div id="github-help-modal" class="settings-help-modal hidden">
  <div class="settings-help-modal-overlay"></div>
  <div class="settings-help-modal-content">
    <div class="settings-help-modal-header">
      <h3 data-i18n="help.github_title">{t.help.github_title}</h3>
      <button class="settings-help-modal-close" data-modal="github-help-modal">&times;</button>
    </div>
    <div class="settings-help-modal-body">
      <p set:html={t.help.github_body1} data-i18n-html="help.github_body1" />
      <p data-i18n="help.github_body2">{t.help.github_body2}</p>
      <ul class="settings-help-list">
        <li set:html={t.help.github_item1} data-i18n-html="help.github_item1" />
        <li set:html={t.help.github_item2} data-i18n-html="help.github_item2" />
        <li set:html={t.help.github_item3} data-i18n-html="help.github_item3" />
      </ul>
    </div>
  </div>
</div>

<!-- AniList — merged: what it's used for (Conexiones' own entry point)
     plus how to get the developer key (Entorno's own entry point), since
     both buttons only ever get to share one modal anyway. -->
<div id="anilist-help-modal" class="settings-help-modal hidden">
  <div class="settings-help-modal-overlay"></div>
  <div class="settings-help-modal-content">
    <div class="settings-help-modal-header">
      <h3 data-i18n="help.anilist_title">{t.help.anilist_title}</h3>
      <button class="settings-help-modal-close" data-modal="anilist-help-modal">&times;</button>
    </div>
    <div class="settings-help-modal-body">
      <p set:html={t.help.anilist_body1} data-i18n-html="help.anilist_body1" />
      <ul class="settings-help-list">
        <li set:html={t.help.anilist_item1} data-i18n-html="help.anilist_item1" />
        <li set:html={t.help.anilist_item2} data-i18n-html="help.anilist_item2" />
        <li set:html={t.help.anilist_item3} data-i18n-html="help.anilist_item3" />
      </ul>
      <p class="settings-help-content-spaced" set:html={t.help.anilist_body2} data-i18n-html="help.anilist_body2" />
      <ol class="settings-help-steps">
        <li set:html={t.help.anilist_step1} data-i18n-html="help.anilist_step1" />
        <li set:html={t.help.anilist_step2} data-i18n-html="help.anilist_step2" />
        <li set:html={t.help.anilist_step3} data-i18n-html="help.anilist_step3" />
        <li set:html={t.help.anilist_step4} data-i18n-html="help.anilist_step4" />
        <li set:html={t.help.anilist_step5} data-i18n-html="help.anilist_step5" />
        <li set:html={t.help.anilist_step6} data-i18n-html="help.anilist_step6" />
      </ol>
      <p class="settings-help-muted" set:html={t.help.anilist_body3} data-i18n-html="help.anilist_body3" />
    </div>
  </div>
</div>

<!-- MyAnimeList — one modal for both entry points (Conexiones' "i" and
     Entorno's), like AniList's. The redirect URI comes from lib/tauri/mal
     so the help text can never drift from what src-tauri/src/mal expects. -->
<div id="mal-help-modal" class="settings-help-modal hidden">
  <div class="settings-help-modal-overlay"></div>
  <div class="settings-help-modal-content">
    <div class="settings-help-modal-header">
      <h3 data-i18n="mal.help_title">{t.mal.help_title}</h3>
      <button class="settings-help-modal-close" data-modal="mal-help-modal">&times;</button>
    </div>
    <div class="settings-help-modal-body">
      <p set:html={t.mal.help_body1} data-i18n-html="mal.help_body1" />
      <p class="settings-help-content-spaced" data-i18n="mal.help_body2">{t.mal.help_body2}</p>
      <ol class="settings-help-list">
        <li set:html={t.mal.help_step1} data-i18n-html="mal.help_step1" />
        <li set:html={t.mal.help_step2} data-i18n-html="mal.help_step2" />
        <li set:html={t.mal.help_step3.replace('{redirect_uri}', MAL_REDIRECT_URI)} data-i18n-html="mal.help_step3" data-i18n-vars={JSON.stringify({ redirect_uri: MAL_REDIRECT_URI })} />
        <li set:html={t.mal.help_step4} data-i18n-html="mal.help_step4" />
      </ol>
      <p class="settings-help-muted" data-i18n="mal.help_body3">{t.mal.help_body3}</p>
    </div>
  </div>
</div>

