        <li>
          <span data-i18n="help.igdb_step4">{t.help.igdb_step4}</span>
          <ul class="settings-help-list settings-help-list--nested">
            <li set:html={t.help.igdb_step4_item1} data-i18n-html="help.igdb_step4_item1" />
            <li set:html={t.help.igdb_step4_item2} data-i18n-html="help.igdb_step4_item2" />
            <li set:html={t.help.igdb_step4_item3} data-i18n-html="help.igdb_step4_item3" />
          </ul>
        </li>
        <li set:html={t.help.igdb_step5} data-i18n-html="help.igdb_step5" />
        <li set:html={t.help.igdb_step6} data-i18n-html="help.igdb_step6" />
        <li set:html={t.help.igdb_step7} data-i18n-html="help.igdb_step7" />
      </ol>
      <p class="settings-help-muted" set:html={t.help.igdb_body2} data-i18n-html="help.igdb_body2" />
      <p class="settings-help-muted settings-help-muted--compact" set:html={t.help.igdb_body3} data-i18n-html="help.igdb_body3" />
    </div>
  </div>
</div>

