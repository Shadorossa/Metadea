---
import { ICON_GITHUB, ICON_IMPORT_DOWNLOAD } from "../../lib/dom/icon-strings";
import type { Translations } from "../../i18n/index";

interface Props {
  t: Translations;
}
const { t } = Astro.props;
---

<!-- Tab: Conexiones -->
<div class="settings-panel hidden" id="panel-application">
  <div
    class="settings-section connections-auth-list"
  >
    <section class="settings-connections-group">
      <div class="settings-connections-group-header">
        <h3 class="settings-connections-group-title" data-i18n="settings.connections_group_anime_manga">{t.settings.connections_group_anime_manga}</h3>
        <span class="settings-connections-group-divider" aria-hidden="true">|</span>
        <span class="settings-connections-group-services">AniList · <span data-i18n="mal.name">{t.mal.name}</span></span>
      </div>
      <div class="settings-connections-row">
        <!-- AniList Auth Block -->
        <div class="settings-auth-block">
          <div class="settings-auth-info">
            <div id="anilist-avatar-container" class="settings-auth-avatar">
              <img src="/API/Anilist_logo.png" class="settings-auth-avatar-img" />
            </div>
            <div class="settings-auth-text">
              <div class="settings-auth-name-row">
                <span class="settings-auth-name">AniList</span>
                <button class="settings-help-btn" data-help="anilist" title={t.settings.anilist_help_title} data-i18n-title="settings.anilist_help_title">
                  <span class="info-indicator" aria-hidden="true">i</span>
                </button>
              </div>
              <span id="anilist-user-status" class="settings-auth-status" data-i18n="settings.auth_not_connected"
                >{t.settings.auth_not_connected}</span
              >
            </div>
          </div>
          <div class="settings-auth-actions">
            <button
              class="btn btn--sm btn--secondary"
              id="anilist-import-btn"
              disabled
            >
              <Fragment set:html={ICON_IMPORT_DOWNLOAD} />
              <span data-i18n="settings.anilist_import_btn">{t.settings.anilist_import_btn}</span>
            </button>
            <button
              class="btn btn--sm btn--primary"
              id="anilist-login-btn" data-i18n="settings.disconnect"
              >{t.settings.disconnect}</button
            >
          </div>
        </div>

        <!-- MyAnimeList Auth Block (deep-link OAuth, see mount/mal.ts) -->
        <div class="settings-auth-block">
          <div class="settings-auth-info">
            <div id="mal-avatar-container" class="settings-auth-avatar">
              <img src="/API/MyAnimeList_logo.svg" class="settings-auth-avatar-img" alt="" />
            </div>
            <div class="settings-auth-text">
              <div class="settings-auth-name-row">
                <span class="settings-auth-name" data-i18n="mal.name">{t.mal.name}</span>
                <button class="settings-help-btn" data-help="mal" title={t.mal.help_title} data-i18n-title="mal.help_title" aria-label={t.mal.help_title} data-i18n-aria-label="mal.help_title">
                  <span class="info-indicator" aria-hidden="true">i</span>
                </button>
              </div>
              <span id="mal-user-status" class="settings-auth-status" data-i18n="settings.auth_not_connected">{t.settings.auth_not_connected}</span>
            </div>
          </div>
          <div class="settings-auth-actions">
            <button
              class="btn btn--sm btn--secondary"
              id="mal-import-btn"
              type="button"
              disabled
            >
              <Fragment set:html={ICON_IMPORT_DOWNLOAD} />
              <span data-i18n="mal.import_btn">{t.mal.import_btn}</span>
            </button>
            <button class="btn btn--sm btn--primary" id="mal-login-btn" type="button" data-i18n="settings.connect"
              >{t.settings.connect}</button
            >
          </div>
        </div>
      </div>
    </section>

    <section class="settings-connections-group">
      <div class="settings-connections-group-header">
        <h3 class="settings-connections-group-title" data-i18n="settings.connections_group_visual_novels">{t.settings.connections_group_visual_novels}</h3>
        <span class="settings-connections-group-divider" aria-hidden="true">|</span>
        <span class="settings-connections-group-services">VNDB</span>
      </div>
      <div class="settings-connections-row">
        <!-- VNDB outbound-sync connection placeholder -->
        <div class="settings-auth-block settings-auth-block--pending">
          <div class="settings-auth-info">
            <div class="settings-auth-avatar settings-auth-avatar--vndb" aria-hidden="true">
              <span>VNDB</span>
            </div>
            <div class="settings-auth-text">
              <span class="settings-auth-name">VNDB</span>
              <span class="settings-auth-status" data-i18n="settings.vndb_coming_soon">{t.settings.vndb_coming_soon}</span>
            </div>
          </div>
          <button class="btn btn--sm btn--secondary" type="button" disabled data-i18n="settings.vndb_coming_soon">
            {t.settings.vndb_coming_soon}
          </button>
        </div>
      </div>
    </section>

    <section class="settings-connections-group">
      <div class="settings-connections-group-header">
        <h3 class="settings-connections-group-title" data-i18n="settings.connections_group_community">{t.settings.connections_group_community}</h3>
        <span class="settings-connections-group-divider" aria-hidden="true">|</span>
        <span class="settings-connections-group-services">GitHub</span>
      </div>
      <div class="settings-connections-row">
        <!-- GitHub Auth Block -->
        <div class="settings-auth-block">
          <div class="settings-auth-info">
            <div id="github-avatar-container" class="settings-auth-avatar">
              <Fragment set:html={ICON_GITHUB} />
            </div>
            <div class="settings-auth-text">
              <div class="settings-auth-name-row">
                <span class="settings-auth-name">GitHub</span>
                <button class="settings-help-btn" data-help="github" title={t.settings.github_help_title} data-i18n-title="settings.github_help_title">
                  <span class="info-indicator" aria-hidden="true">i</span>
                </button>
              </div>
              <span id="github-user-status" class="settings-auth-status" data-i18n="settings.auth_not_connected"
                >{t.settings.auth_not_connected}</span
              >
            </div>
          </div>
          <button class="btn btn--sm btn--primary" id="github-login-btn" data-i18n="settings.connect"
            >{t.settings.connect}</button
          >
        </div>
      </div>
    </section>

    <!-- Import Modal -->
    <div id="anilist-import-choose-modal" class="settings-import-choose-modal">
      <span class="settings-import-modal-title" data-i18n="settings.anilist_import_choose_title">{t.settings.anilist_import_choose_title}</span>

      <div class="settings-import-groups">
        <div class="settings-import-group">
          <span class="settings-import-group-label">Anime</span>
          <div class="settings-import-format-grid">
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-TV" checked />
              <span class="settings-import-format-text">TV</span>
            </label>
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-TV_SHORT" checked />
              <span class="settings-import-format-text">TV Short</span>
            </label>
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-MOVIE" checked />
              <span class="settings-import-format-text">Movie</span>
            </label>
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-SPECIAL" checked />
              <span class="settings-import-format-text">Special</span>
            </label>
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-OVA" checked />
              <span class="settings-import-format-text">OVA</span>
            </label>
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-ONA" checked />
              <span class="settings-import-format-text">ONA</span>
            </label>
          </div>
        </div>

        <div class="settings-import-group">
          <span class="settings-import-group-label">Manga</span>
          <div class="settings-import-format-grid">
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-MANGA" checked />
              <span class="settings-import-format-text">Manga</span>
            </label>
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-ONE_SHOT" checked />
              <span class="settings-import-format-text">One-Shot</span>
            </label>
            <label class="settings-import-format-label">
              <input type="checkbox" id="fmt-NOVEL" checked />
              <span class="settings-import-format-text">Light Novel</span>
            </label>
          </div>
        </div>
      </div>

      <div class="settings-import-actions">
        <button
          class="btn btn--sm btn--primary flex-1"
          id="anilist-import-start-btn" data-i18n="settings.anilist_import_btn"
        >{t.settings.anilist_import_btn}</button>
        <button
          class="btn btn--sm btn--secondary flex-1"
          id="anilist-sync-start-btn" data-i18n="settings.sync"
        >{t.settings.sync}</button>
        <button
          class="btn btn--sm btn--ghost"
          id="anilist-import-cancel-btn" data-i18n="settings.cancel"
        >{t.settings.cancel}</button>
      </div>
    </div>

    <!-- GitHub Device Flow modal -->
    <div id="github-device-modal" class="settings-modal">
      <span class="settings-modal-title" data-i18n="settings.github_login_title">{t.settings.github_login_title}</span>
      <p class="settings-modal-hint" data-i18n="settings.github_device_hint">
        {t.settings.github_device_hint}
      </p>
      <div id="github-device-code-box" class="settings-modal-code">
        ----
      </div>
      <a
        href="https://github.com/login/device"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--sm btn--secondary settings-modal-link" data-i18n="settings.github_open_device_link"
        >{t.settings.github_open_device_link}</a
      >
      <button
        class="btn btn--sm btn--ghost connection-cancel-btn"
        id="github-cancel-device-btn" data-i18n="settings.cancel"
      >{t.settings.cancel}</button
      >
    </div>

    <!-- AniList token prompt modal -->
    <div id="anilist-token-modal" class="settings-modal">
      <span class="settings-modal-title" data-i18n="settings.anilist_login_title">{t.settings.anilist_login_title}</span>
      <p class="settings-modal-hint" data-i18n="settings.anilist_token_step1">
        {t.settings.anilist_token_step1}
      </p>
      <a
        href="#"
        id="anilist-auth-link"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--sm btn--secondary settings-modal-link" data-i18n="settings.anilist_open_auth_page"
        >{t.settings.anilist_open_auth_page}</a
      >
      <p class="settings-modal-hint settings-modal-hint--spaced" data-i18n="settings.anilist_token_step2">
        {t.settings.anilist_token_step2}
      </p>
      <input
        type="text"
        id="anilist-token-input"
        placeholder={t.settings.anilist_token_placeholder} data-i18n-placeholder="settings.anilist_token_placeholder"
        class="settings-modal-input"
      />
      <div class="settings-modal-actions">
        <button
          class="btn btn--sm btn--primary"
          id="anilist-save-token-btn" data-i18n="settings.anilist_validate_save"
          >{t.settings.anilist_validate_save}</button
        >
        <button
          class="btn btn--sm btn--ghost"
          id="anilist-cancel-token-btn" data-i18n="settings.cancel"
          >{t.settings.cancel}</button
        >
      </div>
    </div>

    <!-- MyAnimeList login modal: waits for the metadea://auth/mal return,
         with a paste field as the fallback when the browser never comes back -->
    <div id="mal-login-modal" class="settings-modal" role="dialog" aria-modal="true" aria-labelledby="mal-login-title">
      <span class="settings-modal-title" id="mal-login-title" data-i18n="mal.login_title">{t.mal.login_title}</span>
      <p class="settings-modal-hint" data-i18n="mal.login_waiting">{t.mal.login_waiting}</p>
      <button type="button" id="mal-open-auth-btn" class="btn btn--sm btn--secondary settings-modal-link" data-i18n="mal.login_open_again"
        >{t.mal.login_open_again}</button
      >
      <p class="settings-modal-hint settings-modal-hint--spaced" data-i18n="mal.login_fallback_hint">{t.mal.login_fallback_hint}</p>
      <input
        type="text"
        id="mal-redirect-input"
        placeholder={t.mal.login_fallback_placeholder} data-i18n-placeholder="mal.login_fallback_placeholder"
        class="settings-modal-input"
        autocomplete="off"
      />
      <div class="settings-modal-actions">
        <button type="button" class="btn btn--sm btn--primary" id="mal-complete-btn" data-i18n="mal.login_fallback_submit"
          >{t.mal.login_fallback_submit}</button
        >
        <button type="button" class="btn btn--sm btn--ghost" id="mal-cancel-btn" data-i18n="settings.cancel"
          >{t.settings.cancel}</button
        >
      </div>
    </div>
  </div>
</div>
