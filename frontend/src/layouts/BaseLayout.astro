---
import '../styles/core/global.css';
import '../styles/components/components.css';
import '../styles/components/toast.css';
import '../styles/components/tooltip.css';
import '../styles/components/navbar.css';
import '../styles/components/quick-search.css';
import '../styles/components/footer.css';
import '../styles/components/global-loading-bar.css';
import '../styles/components/shortcut-sheet.css';
import '../styles/components/spoiler-shield.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { QuickSearchOverlay } from '../components/search/QuickSearchOverlay';
import { GlobalShortcuts } from '../components/shared/GlobalShortcuts';
import { ChangelogLauncher } from '../components/changelog/ChangelogLauncher';
import '../styles/components/changelog.css';
import { NowPlayingBar } from '../components/local/NowPlayingBar';
import { GamePauseOverlay } from '../components/game-pause/GamePauseOverlay';
import '../styles/components/game-pause.css';
import { NowReadingBar } from '../components/reader/NowReadingBar';
import { UiThemeLoader } from '../components/ui-themes/UiThemeLoader';
import '../styles/components/now-playing-bar.css';
import { JukeboxIsland } from '../components/jukebox/JukeboxIsland';
import '../styles/components/jukebox.css';
import { AmbientModeIsland } from '../components/ambient/AmbientModeIsland';
import { CharacterPrEditorModal } from '../components/character/CharacterPrEditorModal';
import type { Locale } from '../i18n/index';
import { useTranslations } from '../i18n/index';
import { STORAGE_KEYS } from '../lib/storage/storage-keys';
import ClientRouter from 'astro/components/ClientRouter.astro';
import LocaleBootstrap from '../components/i18n/LocaleBootstrap.astro';

import '../styles/core/themes/nebula.css';
import '../styles/core/themes/cyberpunk.css';
import '../styles/core/themes/newspaper-dark.css';
import '../styles/core/themes/pipboy.css';
import '../styles/core/themes/glassmorphism.css';
import '../styles/core/themes/synthwave.css';
import '../styles/core/themes/steampunk.css';
import '../styles/core/themes/cyberneon.css';
import '../styles/core/themes/scifi.css';
import '../styles/core/themes/gothic.css';
import '../styles/core/themes/glitch.css';
import '../styles/core/themes/luxury.css';
import '../styles/core/themes/jungle.css';
import '../styles/core/themes/blueprint.css';

interface Props {
  title: string;
  /** Dot-path key of the page name so the tab title follows the runtime
   *  locale (rendered as `<value><titleSuffix>`); `title` is the build-time text. */
  titleKey?: string;
  titleSuffix?: string;
  lang: Locale;
  activePage?: 'home' | 'search' | 'local' | 'notifications' | 'profile' | 'settings' | 'tier' | 'admin';
}

const { title, titleKey, titleSuffix = ' — Metadea', lang, activePage } = Astro.props;
const t = useTranslations(lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- First: resolves the UI locale before paint (components/i18n/). -->
    <LocaleBootstrap buildLang={lang} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-i18n-doc-title={titleKey} data-i18n-suffix={titleKey ? titleSuffix : undefined}>{title}</title>
    <ClientRouter />

    <!-- React Refresh Dev Mock Workaround -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        window.$RefreshReg$ = window.$RefreshReg$ || function() {};
        window.$RefreshSig$ = window.$RefreshSig$ || function() { return function(type) { return type; }; };
      }
    </script>

    <!-- Apply theme before CSS loads to prevent flash -->
    <script is:inline define:vars={{ themeStorageKey: STORAGE_KEYS.appTheme }}>
      function applyTheme() {
        const t = localStorage.getItem(themeStorageKey) || 'nebula';
        document.documentElement.setAttribute('data-theme', t);
      }
      applyTheme();
      // Re-aplicar inmediatamente después de que Astro intercambie el HTML
      document.addEventListener('astro:after-swap', applyTheme);
      document.addEventListener('astro:page-load', applyTheme);
      window.__updateTheme = function(newTheme) {
        localStorage.setItem(themeStorageKey, newTheme);
        applyTheme();
      };
    </script>

  </head>
  <body data-page={activePage}>
    <div id="app-bg" aria-hidden="true" transition:persist></div>
    <Navbar activePage={activePage} i18n={t.nav} typeLabels={t.search.types} />
    <QuickSearchOverlay client:load />
    <!-- Keyboard shortcuts: the single window keydown dispatcher, the
         global bindings (mod+K, mod+1..6, alt+arrows, ?) and the "?" sheet.
         See lib/shared/keyboard/shortcut-registry.ts. -->
    <GlobalShortcuts client:load transition:persist />
    <!-- "What's new" modal: opens once per new app version with its
         CHANGELOG.md section, and from [data-open-changelog] buttons. -->
    <ChangelogLauncher client:load transition:persist />
    <div id="page-content" transition:name="page-content">
      <slot />
    </div>
    <Footer lang={lang} />

    <!-- Global "now playing" bar (see NowPlayingBar.tsx) — outside
         #page-content and transition:persist so it survives page swaps the
         same way #global-toast/#app-bg do. -->
    <NowPlayingBar client:load transition:persist />
    <!-- Controller pause menu (components/game-pause/, src-tauri/src/game_pause):
         shows over any page when a game launched from Metadea is paused. -->
    <GamePauseOverlay client:load transition:persist />
    <NowReadingBar client:load transition:persist />
    <!-- Jukebox mini player (components/jukebox/, lib/jukebox/): the OP/ED
         favourites queue and its audio element outlive every page. -->
    <JukeboxIsland client:load transition:persist />
    <!-- Ambient TV mode (components/ambient/, lib/ambient/): screensaver after
         the idle delay in fullscreen / Big Picture; loads its overlay on first use. -->
    <AmbientModeIsland client:idle transition:persist />

    <!-- User UI themes / skins (docs/THEMING.md): injects the active theme's
         <style id="metadea-ui-theme"> after every stylesheet above and owns
         the mod+shift+t "deactivate theme" escape hatch. -->
    <UiThemeLoader client:load transition:persist />

    <!-- Global character editor (see window.__metadeaCharacterEditor in
         lib/shared/editor-session-bus.ts) — used to only be mounted per-page
         (character.astro, admin/catalog.astro), which meant the editor API
         was undefined anywhere else
         PrEditorModal's own "+ Crear personaje"/character list can open it
         from (e.g. the actual media page) — the button silently did nothing
         since that call is optional-chained. Mounted here once instead, so
         it's always available regardless of which page opened it from. -->
    <CharacterPrEditorModal client:load transition:persist />

    <!-- Global bottom toast (app-update check on startup, etc.) — persists
         across Astro page transitions since the check that drives it only
         ever runs once per app session, not per page. -->
    <div id="global-toast" class="global-toast" transition:persist></div>

    <!-- Global bottom loading bar — driven by lib/shared/global-loading.ts
         (beginGlobalLoading/withGlobalLoading) from anywhere in the app,
         instead of each screen rolling its own "Cargando..." placeholder. -->
    <div id="global-loading-bar" class="global-loading-bar" transition:persist>
      <div class="global-loading-bar-fill"></div>
    </div>

    <!-- Auth modal -->
    <dialog id="auth-modal" class="auth-modal">
      <div class="auth-modal-box">

        <p class="modal-title" data-i18n="auth.create_local_profile">{t.auth.create_local_profile}</p>

        <form id="modal-login-form" style="display: flex; flex-direction: column; gap: 0.75rem; width: 100%;">
          <input 
            type="text" 
            id="modal-username-input" 
            class="input-dark" 
            placeholder={t.auth.username_placeholder}
            data-i18n-placeholder="auth.username_placeholder"
            required
            minlength="3" 
            maxlength="20"
          />
          <button type="submit" class="btn btn--primary" style="justify-content: center; width: 100%;" data-i18n="auth.start">{t.auth.start}</button>
        </form>

        <!-- Close -->
        <button class="auth-close" id="close-auth-modal" aria-label={t.auth.close} data-i18n-aria-label="auth.close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </dialog>

    <script>
      import { STORAGE_KEYS } from '../lib/storage/storage-keys';

      // Auth modal — runs on first load and after each View Transitions swap
      function initAuthModal() {
        const modal     = document.getElementById('auth-modal') as HTMLDialogElement | null;
        const closeBtn  = document.getElementById('close-auth-modal');
        const modalForm = document.getElementById('modal-login-form');
        const modalInput = document.getElementById('modal-username-input') as HTMLInputElement | null;

        closeBtn?.addEventListener('click', () => modal?.close());
        modal?.addEventListener('click', (e) => { if (e.target === modal) modal?.close(); });

        modalForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const username = modalInput?.value.trim();
          if (username) {
            try {
              const { storeAuthToken } = await import(/* @vite-ignore */ '../lib/tauri');
              await storeAuthToken('offline_token', username);
              if (localStorage.getItem(STORAGE_KEYS.onboardingCompleted) !== '1') {
                window.location.replace('/welcome');
              } else {
                window.location.reload();
              }
            } catch {
              console.error('Error storing token');
            }
          }
        });
      }
      
      let updaterChecked = false;
      let activityFeedsRefreshed = false;

      function isTauriRuntime() {
        return typeof window !== 'undefined' &&
          ('__TAURI_IPC__' in window || '__TAURI_INTERNALS__' in window || '__TAURI__' in window || '__TAURI_OAM__' in window);
      }

      // Runs once per app launch (sessionStorage gate, like the updater
      // check) and always reports the outcome, so every start visibly
      // confirms the community catalog from GitHub was fetched.
      async function syncCommunityCatalog() {
        if (!isTauriRuntime()) return;
        if (!navigator.onLine) return;
        const { getT } = await import('../i18n/runtime');
        const tm = getT().settings;
        try {
          const { syncCommunityCatalog: sync } = await import(/* @vite-ignore */ '../lib/tauri');
          const imported = await sync();
          localStorage.setItem(STORAGE_KEYS.communityCatalogLastSync, String(Date.now()));
          showGlobalToast(
            imported > 0
              ? tm.community_catalog_synced_count.replace('{count}', String(imported))
              : tm.community_catalog_synced,
            2500,
          );
        } catch (error) {
          console.warn('[CommunityCatalog] Sync failed:', error);
          showGlobalToast(tm.community_catalog_sync_failed, 3500);
        }
      }

      // Shared with the manual "Buscar actualizaciones" button in Settings
      // (lib/settings/updater.ts) — same toast element, so only one status
      // message is ever visible regardless of which path triggered it.
      // Timed messages queue behind each other (update check, then the
      // community-data confirmation) instead of overwriting one another; an
      // untimed status ("checking…") is replaced by whatever comes next.
      let toastHideTimer: ReturnType<typeof setTimeout> | null = null;
      let toastBusyUntil = 0;
      function showGlobalToast(msg: string, autoHideMs?: number) {
        const el = document.getElementById('global-toast');
        if (!el) return;
        const wait = Math.max(0, toastBusyUntil - Date.now());
        if (autoHideMs) toastBusyUntil = Date.now() + wait + autoHideMs;
        setTimeout(() => {
          if (toastHideTimer) { clearTimeout(toastHideTimer); toastHideTimer = null; }
          el.textContent = msg;
          el.classList.add('visible');
          if (autoHideMs) toastHideTimer = setTimeout(() => el.classList.remove('visible'), autoHideMs);
        }, wait);
      }
      function hideGlobalToast() {
        if (toastHideTimer) { clearTimeout(toastHideTimer); toastHideTimer = null; }
        document.getElementById('global-toast')?.classList.remove('visible');
      }

      // Global bottom loading bar (lib/shared/global-loading.ts) — ref
      // counted so e.g. two tabs loading at once don't hide it as soon as
      // the first one finishes.
      let globalLoadingRefCount = 0;
      window.addEventListener('metadea:loading-start', () => {
        globalLoadingRefCount++;
        document.getElementById('global-loading-bar')?.classList.add('visible');
      });
      window.addEventListener('metadea:loading-end', () => {
        globalLoadingRefCount = Math.max(0, globalLoadingRefCount - 1);
        if (globalLoadingRefCount === 0) {
          document.getElementById('global-loading-bar')?.classList.remove('visible');
        }
      });

      // Own rate limiter (lib/api/rate-limiter.ts) dispatches this whenever
      // it has to delay an AniList call to stay under budget — shown on
      // every page (not gated to Home like the updater toast above) since
      // it can fire from Search, a media page, the library import, etc.
      let rateLimitToastTimer: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('metadea:rate-limit-wait', (async (e: CustomEvent<{ provider: string; waitMs: number }>) => {
        const { getT } = await import('../i18n/runtime');
        const template = getT().settings.rate_limit_wait || 'Waiting on {provider}\'s rate limit...';
        showGlobalToast(template.replace('{provider}', e.detail.provider));
        clearTimeout(rateLimitToastTimer);
        rateLimitToastTimer = setTimeout(hideGlobalToast, e.detail.waitMs);
      }) as EventListener);

      // The toast is only ever shown on Home — every other page stays silent
      // (still checks and still shows the "new version" confirm() dialog if
      // one is actually found, just without the "checking.../up to date"
      // cosmetic feedback, which would otherwise pop up mid-navigation on
      // whatever page the user happens to be on).
      function isOnHomePage() {
        return document.body?.dataset.page === 'home';
      }

      async function checkAppUpdates() {
        if (!isTauriRuntime()) return;
        if (!navigator.onLine) return;
        const { getT } = await import('../i18n/runtime');
        const tm = getT().settings;
        const showStatus = isOnHomePage();
        if (showStatus) showGlobalToast(tm.app_checking_update);
        try {
          const { check } = await import('@tauri-apps/plugin-updater');
          const { relaunch } = await import('@tauri-apps/plugin-process');

          const update = await check();
          if (update && update.available) {
            hideGlobalToast();
            const confirmUpdate = confirm(tm.app_update_found.replace('{version}', update.version));
            if (confirmUpdate) {
              await update.downloadAndInstall();
              await relaunch();
            }
          } else if (showStatus) {
            showGlobalToast(tm.app_up_to_date, 2500);
          }
        } catch (error) {
          console.warn("[Updater] No se pudo comprobar actualizaciones:", error);
          if (showStatus) hideGlobalToast();
        }
      }

      // Cache current path to restore session after full reloads/restarts
      function rememberCurrentPath() {
        const pathname = window.location.pathname;
        const search = window.location.search;
        const hash = window.location.hash;
        const fullPath = pathname + search + hash;

        // The onboarding route is a one-time launch flow, not a page to
        // restore as the user's last working location after setup.
        if (pathname === '/welcome') return;

        // Don't save root or login pages
        if (pathname === '/' || pathname === '/login') {
          localStorage.removeItem(STORAGE_KEYS.lastVisitedPath);
          return;
        }

        localStorage.setItem(STORAGE_KEYS.lastVisitedPath, fullPath);
      }
      rememberCurrentPath();

      // Listeners and periodic check to keep the cached path updated
      window.addEventListener('beforeunload', rememberCurrentPath);
      setInterval(rememberCurrentPath, 1000);

      document.addEventListener('astro:page-load', async () => {
        try {
          const { initTauriDatabase } = await import('../lib/tauri');
          await initTauriDatabase();
          const { startLibraryReleaseNotifications } = await import('../lib/notifications/library-release-notifications');
          startLibraryReleaseNotifications();
        } catch (e) {
          console.error(e);
        }
        initAuthModal();
        setTimeout(rememberCurrentPath, 0);

        // sessionStorage, not just the in-memory updaterChecked flag below —
        // this script tag re-runs on every Astro page transition (each one
        // re-declares `let updaterChecked = false`), so the in-memory flag
        // alone let the update check (and its toast) fire again on every
        // single navigation instead of once per app launch.
        if (!updaterChecked && !sessionStorage.getItem(STORAGE_KEYS.updaterCheckedThisSession)) {
          updaterChecked = true;
          sessionStorage.setItem(STORAGE_KEYS.updaterCheckedThisSession, '1');
          setTimeout(checkAppUpdates, 2000);
        }
        if (!sessionStorage.getItem(STORAGE_KEYS.communityCatalogSyncedThisSession)) {
          sessionStorage.setItem(STORAGE_KEYS.communityCatalogSyncedThisSession, '1');
          setTimeout(syncCommunityCatalog, 3000);
        }

        // Refresh the activity feeds once per app session. Profile uploads
        // are user-confirmed from Home rather than automatic.
        if (!activityFeedsRefreshed) {
          activityFeedsRefreshed = true;
          setTimeout(async () => {
            const { refreshActivityFeed, refreshGeneralActivityFeed } = await import(/* @vite-ignore */ '../lib/social/activity-feed');
            refreshActivityFeed().catch(() => {});
            refreshGeneralActivityFeed().catch(() => {});
          }, 4000);
        }

        if (!window.location.pathname.startsWith('/media')) {
          import('../lib/local/discord-presence').then(m => m.requestDiscordIdle()).catch(() => {});
        }
        // A game launched from Metadea keeps its presence across pages: the
        // Rust session registry is the source (lib/local/game-session-state).
        import('../lib/local/game-session-state').then(m => m.initGameSessionPresence()).catch(() => {});

        // metadea:// links (lib/deep-link/) — idempotent, so re-running this
        // handler after a page swap never stacks a second listener.
        import('../lib/deep-link/deep-link-listener').then(m => m.registerDeepLinkListener()).catch(() => {});
      });
    </script>


  </body>
</html>
