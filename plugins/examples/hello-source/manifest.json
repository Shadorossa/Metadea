{
  "id": "org.metadea.examples.hello-source",
  "name": "Hello Source",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "Metadea",
  "description": "Example plugin: a reading source with made-up works, a media-page action and panel, and an event subscription. No network access.",
  "icon": "icon.svg",
  "main": "main.js",
  "permissions": {
    "hosts": [],
    "settingsHosts": [],
    "capabilities": []
  },
  "settings": [
    { "key": "greeting", "type": "string", "label": "Greeting", "default": "Hello", "placeholder": "Hello" },
    { "key": "pagesPerChapter", "type": "number", "label": "Pages per chapter", "default": 4, "min": 1, "max": 20 },
    { "key": "showPanel", "type": "boolean", "label": "Show the media-page panel", "default": true },
    {
      "key": "palette",
      "type": "select",
      "label": "Page colours",
      "default": "warm",
      "options": [
        { "value": "warm", "label": "Warm" },
        { "value": "cool", "label": "Cool" }
      ]
    }
  ],
  "contributes": {
    "sources": [
      { "id": "hello", "name": "Hello Library", "types": ["manga", "comic", "lnovel"], "language": "en" }
    ],
    "workActions": [
      { "id": "say-hello", "label": "Say hello", "types": ["manga", "comic", "lnovel", "anime"] }
    ],
    "workPanels": [
      { "id": "hello-panel", "label": "Hello Source", "types": ["manga", "comic", "lnovel"] }
    ],
    "events": ["progress.changed", "session.ended"]
  }
}
